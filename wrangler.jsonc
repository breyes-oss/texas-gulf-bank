{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static-assets Worker only: no `main` script and no Astro Cloudflare adapter.
  // `functions/` is the Pages CMS OAuth backend. It stays at the repo root, outside
  // `assets.directory`, so `wrangler deploy` does not upload or run it.
  "name": "texas-gulf-bank",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}
