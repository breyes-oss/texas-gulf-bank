---
// HeroSection.astro — Authentic Gulf Coast community hero
const { home } = Astro.props;
const openAccountUrl = "https://app.loanspq.com/apply.aspx?enc=Kw21Wblm1yxpjJabdoZaD_1XCeB6DUzWcPY_g38Z9Jqr0clsjQUYVmTraoEngafVkCgQedLZhb-S5_xgQhN9fA";
---

<section class="relative overflow-hidden bg-brand-cream">
  <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8 py-5 lg:py-7">
    <div class="relative min-h-[650px] lg:min-h-[720px] overflow-hidden bg-brand-navy">
      <img
        src="/hero-community.png"
        alt="Local business owners outside their Gulf Coast storefront"
        class="absolute inset-0 h-full w-full object-cover object-[42%_center]"
        width="1536"
        height="864"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-navy/95 via-brand-navy/80 to-brand-aqua/25"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/40 via-transparent to-transparent"></div>

      <div class="relative z-10 max-w-7xl mx-auto min-h-[650px] lg:min-h-[720px] px-6 sm:px-10 lg:px-16 py-16 lg:py-24 flex items-center">
        <div class="max-w-2xl">
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-[5rem] font-black text-white leading-[1.02] tracking-tight text-balance">
            {home.hero_headline || "A Community Bank"}
            <span class="block mt-2 text-brand-gold-light">{home.hero_headline_accent || "Rooted In Texas"}</span>
          </h1>

          <p class="mt-7 text-lg sm:text-xl text-white/85 leading-relaxed max-w-xl text-balance font-sans">
            {home.hero_subtext || "From the Gulf Coast to your neighborhood — local decisions and real relationships have helped Texas families and businesses grow for generations."}
          </p>

          <div class="mt-10 flex flex-col sm:flex-row gap-3">
            <a href={openAccountUrl} class="inline-flex items-center justify-center gap-2 bg-brand-gold text-brand-navy px-7 py-3.5 rounded-lg text-base font-bold hover:bg-brand-gold-light transition-colors">
              {home.hero_primary_cta || "Open an Account"}
            </a>
            <a href="https://www.texasgulfbank.com/locations/" class="inline-flex items-center justify-center gap-2 bg-white/10 border border-white/35 text-white px-7 py-3.5 rounded-lg text-base font-semibold hover:bg-white hover:text-brand-navy transition-colors backdrop-blur-sm">
              {home.hero_secondary_cta || "Find a Branch"}
            </a>
          </div>

          <p class="mt-6 text-sm text-white/70 font-sans">Personal relationships. Local decision-makers. Texas Gulf Coast expertise.</p>
        </div>
      </div>
    </div>
  </div>
</section>
