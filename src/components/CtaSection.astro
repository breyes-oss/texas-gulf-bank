---
// CtaSection.astro — Final call to action before footer
const { home } = Astro.props;
---

<section class="bg-brand-navy py-16 lg:py-24">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-black text-white leading-[1.1] tracking-tight text-balance">
      {home.cta_headline || "Ready to bank with"}
      <span class="block text-brand-gold">{home.cta_headline_accent || "Texas Gulf Bank?"}</span>
    </h2>

    <p class="mt-5 text-lg text-white/80 max-w-2xl mx-auto text-balance font-sans">
      {home.cta_subtext || "Whether you're opening your first account or growing a business, we're here to help. Stop by any branch or give us a call."}
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/locations/" class="inline-flex items-center justify-center gap-2 bg-brand-gold text-brand-navy px-8 py-3.5 rounded-lg text-base font-bold hover:bg-brand-gold-light transition-colors">
        {home.cta_primary_button || "Find a Branch Near You"}
      </a>
      <a href="tel:8004677216" class="inline-flex items-center justify-center gap-2 border border-white/30 text-white px-8 py-3.5 rounded-lg text-base font-semibold hover:bg-white/10 transition-colors">
        {home.cta_phone || "800.467.7216"}
      </a>
    </div>
  </div>
</section>
