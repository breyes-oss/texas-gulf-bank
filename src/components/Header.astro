---
// Header.astro — sticky header that shrinks on scroll:
// FDIC sign fades/collapses, logo gets smaller, soft shadow appears.
import FdicDigitalSign from './FdicDigitalSign.astro';

interface NavLink {
  label: string;
  href: string;
  active?: boolean;
}

interface Props {
  links?: NavLink[];
  showCta?: boolean;
  showHamburger?: boolean;
}

const {
  showCta = true,
  showHamburger = true,
  links = [
    { label: "Business", href: "https://www.texasgulfbank.com/business-checking/" },
    { label: "Personal", href: "https://www.texasgulfbank.com/personal-checking/" },
    { label: "Rates & Fees", href: "/rates-and-fees" },
    { label: "Wealth", href: "https://www.texasgulfbank.com/wealth-management/" },
    { label: "About", href: "https://www.texasgulfbank.com/about-texas-gulf-bank/" },
    { label: "Support", href: "https://www.texasgulfbank.com/frequently-asked-questions/" },
  ],
} = Astro.props;
---

<header class="site-header bg-white sticky top-0 z-50" data-shrink-header>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full">
    <div class="flex items-center justify-between h-full">
      <!-- Logo + FDIC sign (FDIC fades away on scroll) -->
      <div class="flex flex-col items-start justify-center gap-0">
        <a href="/" class="flex items-center group" aria-label="Texas Gulf Bank home">
          <img src="/logo-navy.png" alt="Texas Gulf Bank" class="logo-img w-auto" />
        </a>
        <div class="fdic-fade overflow-hidden">
          <FdicDigitalSign />
        </div>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "px-4 py-2 text-sm font-medium rounded-lg transition-colors",
              l.active
                ? "text-brand-gold-dark bg-brand-gold-pale/30"
                : "text-brand-text hover:text-brand-navy-light hover:bg-gray-50",
            ]}
          >
            {l.label}
          </a>
        ))}
      </nav>

      <!-- CTA + Mobile Toggle -->
      {showCta && (
        <div class="flex items-center gap-3">
          <a
            href="https://www.netteller.com/login2008/Authentication/Views/Login.aspx?returnUrl=%2Ftexasgulfbank"
            class="hidden sm:inline-flex items-center gap-2 bg-brand-gold text-brand-navy px-5 py-2.5 rounded-lg text-sm font-bold hover:bg-brand-gold-light transition-colors shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Online Banking
          </a>
          {showHamburger && (
            <button
              class="menu-toggle lg:hidden p-2 rounded-lg transition-colors"
              aria-label="Menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
              data-menu-toggle
            >
              <svg class="icon-burger w-6 h-6 text-brand-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg class="icon-close w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M6 18L18 6" />
              </svg>
            </button>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Mobile full-screen menu overlay (covers the header bar entirely) -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Overlay top bar: white logo on navy, aligned where the header logo sits -->
      <div class="mobile-menu-top">
        <img src="/logo-white.png" alt="Texas Gulf Bank" class="mobile-menu-logo" />
      </div>

      <nav class="mobile-menu-nav" aria-label="Mobile navigation">
        <div class="menu-section">
          <h3 class="menu-section-title font-display">Business</h3>
          <ul class="menu-links">
            <li><a href="https://www.texasgulfbank.com/business-checking/">Business Checking</a></li>
            <li><a href="https://www.texasgulfbank.com/business-loans-financing/">Business Loans</a></li>
            <li><a href="https://www.texasgulfbank.com/business-card-services/">Card Services</a></li>
            <li><a href="https://www.texasgulfbank.com/treasury-services-2024/">Treasury Services</a></li>
            <li><a href="https://www.texasgulfbank.com/remote-deposit/">Remote Deposit</a></li>
          </ul>
        </div>

        <div class="menu-section">
          <h3 class="menu-section-title font-display">Personal</h3>
          <ul class="menu-links">
            <li><a href="https://www.texasgulfbank.com/personal-checking/">Personal Checking</a></li>
            <li><a href="https://www.texasgulfbank.com/personal-savings-cds-iras/">Savings &amp; CDs</a></li>
            <li><a href="https://www.texasgulfbank.com/loans/">Personal Loans</a></li>
            <li><a href="https://www.texasgulfbank.com/online-and-mobile-banking/">Online Banking</a></li>
            <li><a href="https://www.texasgulfbank.com/zelle/">Zelle®</a></li>
            <li><a href="/rates-and-fees">Rates &amp; Fees</a></li>
          </ul>
        </div>

        <div class="menu-section">
          <h3 class="menu-section-title font-display">Wealth</h3>
          <ul class="menu-links">
            <li><a href="https://www.texasgulfbank.com/wealth-management/">Wealth Management</a></li>
            <li><a href="https://www.texasgulfbank.com/safeguarding-your-childs-financial-future-a-special-needs-trust/">Special Needs Trusts</a></li>
            <li><a href="https://www.texasgulfbank.com/wealth-management/">Financial Planning</a></li>
          </ul>
        </div>

        <div class="menu-section">
          <h3 class="menu-section-title font-display">About</h3>
          <ul class="menu-links">
            <li><a href="https://www.texasgulfbank.com/our-story-texas-gulf-bank/">Our Story</a></li>
            <li><a href="https://www.texasgulfbank.com/our-team/">Leadership</a></li>
            <li><a href="https://www.texasgulfbank.com/community-0/">Community</a></li>
            <li><a href="/blog">Blog</a></li>
          </ul>
        </div>
      </nav>

      <!-- Bottom: Online Banking CTA (header CTA is hidden on phones) + trust line -->
      <div class="mobile-menu-bottom">
        <a
          href="https://www.netteller.com/login2008/Authentication/Views/Login.aspx?returnUrl=%2Ftexasgulfbank"
          class="inline-flex items-center justify-center gap-2 bg-brand-gold text-brand-navy px-6 py-3 rounded-lg text-sm font-bold hover:bg-brand-aqua transition-colors shadow-sm w-full sm:w-auto"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Online Banking
        </a>
        <p class="text-xs text-white/60">Member FDIC · Equal Housing Lender</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    height: 4rem; /* h-16 */
    border-bottom: 1px solid #f3f4f6; /* gray-100 */
    transition: height 0.28s ease, box-shadow 0.28s ease, border-radius 0.28s ease,
      margin 0.28s ease, top 0.28s ease, border-color 0.28s ease,
      background-color 0.28s ease;
  }
  .logo-img {
    height: 2rem; /* h-8 */
    transition: height 0.28s ease;
  }
  .fdic-fade {
    max-height: 48px;
    opacity: 1;
    transition: opacity 0.28s ease, max-height 0.28s ease;
  }
  .site-header.is-scrolled {
    height: 3.25rem; /* compact pill */
    top: 0.5rem;
    margin-inline: 0.75rem;
    border-radius: 9999px; /* pill */
    border-bottom-color: transparent;
    background-color: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.14);
  }
  @media (min-width: 640px) {
    .site-header.is-scrolled {
      margin-inline: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .site-header.is-scrolled {
      top: 0.75rem;
      margin-inline: 2rem;
    }
  }
  .site-header.is-scrolled .logo-img {
    height: 1.5rem; /* h-6 */
  }
  .site-header.is-scrolled .fdic-fade {
    max-height: 0;
    opacity: 0;
  }
  @media (min-width: 1024px) {
    .site-header {
      height: 5rem; /* lg:h-20 */
    }
    .logo-img {
      height: 2.5rem; /* lg:h-10 */
    }
    .site-header.is-scrolled {
      height: 3.5rem; /* lg:h-14 */
    }
    .site-header.is-scrolled .logo-img {
      height: 2rem; /* lg:h-8 */
    }
  }
  /* ── Mobile full-screen menu ── */
  .menu-toggle {
    position: relative;
    z-index: 70; /* stays clickable above the overlay */
  }
  .menu-toggle .icon-close {
    display: none;
  }
  .menu-toggle.is-open .icon-burger {
    display: none;
  }
  .menu-toggle.is-open .icon-close {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background-color: var(--color-brand-navy);
    background-image: linear-gradient(135deg, rgba(57, 182, 211, 0.1) 0%, rgba(25, 41, 75, 0) 55%);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0s linear 0.28s;
  }
  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.28s ease;
  }

  .mobile-menu-top {
    display: flex;
    align-items: center;
    height: 4rem; /* matches header height */
  }
  .mobile-menu-logo {
    height: 2rem;
    width: auto;
  }
  @media (min-width: 1024px) {
    .mobile-menu-top {
      height: 5rem;
    }
    .mobile-menu-logo {
      height: 2.5rem;
    }
  }

  .mobile-menu-nav {
    padding: 1rem 0 0.75rem;
  }
  .menu-section + .menu-section {
    margin-top: 1.75rem;
  }
  .menu-section-title {
    color: var(--color-brand-aqua);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(57, 182, 211, 0.4);
    margin-bottom: 0.35rem;
  }
  .menu-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-links a {
    display: block;
    padding: 0.4rem 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.02rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color 0.18s ease, padding-left 0.18s ease;
  }
  .menu-links a:hover,
  .menu-links a:focus-visible {
    color: var(--color-brand-aqua);
    padding-left: 0.4rem;
  }

  .mobile-menu-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.5rem 0 2.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .logo-img,
    .fdic-fade {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector("[data-shrink-header]");
  if (header) {
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 16);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // Mobile full-screen menu toggle
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const mobileMenu = document.getElementById("mobile-menu");
  if (menuToggle && mobileMenu) {
    const closeMenu = () => {
      document.body.classList.remove("menu-open");
      mobileMenu.classList.remove("is-open");
      mobileMenu.setAttribute("aria-hidden", "true");
      menuToggle.classList.remove("is-open");
      menuToggle.setAttribute("aria-expanded", "false");
    };
    const openMenu = () => {
      document.body.classList.add("menu-open");
      mobileMenu.classList.add("is-open");
      mobileMenu.setAttribute("aria-hidden", "false");
      menuToggle.classList.add("is-open");
      menuToggle.setAttribute("aria-expanded", "true");
    };
    menuToggle.addEventListener("click", () => {
      if (mobileMenu.classList.contains("is-open")) {
        closeMenu();
      } else {
        openMenu();
      }
    });
    // Close when a menu link is chosen
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });
    // Close if resized to desktop (hamburger is hidden there)
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) closeMenu();
    });
  }
</script>
