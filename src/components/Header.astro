---
// Header.astro — sticky header that shrinks on scroll, with desktop dropdown nav.
interface SubLink {
  label: string;
  href: string;
}

interface NavItem {
  label: string;
  href: string;
  children?: SubLink[];
  active?: boolean;
}

interface Props {
  links?: NavItem[];
  showCta?: boolean;
  showHamburger?: boolean;
}

const {
  showCta = true,
  showHamburger = true,
  links = [
    {
      label: "Personal",
      href: "https://www.texasgulfbank.com/personal-checking/",
      children: [
        { label: "Personal Checking", href: "https://www.texasgulfbank.com/personal-checking/" },
        { label: "Savings & CDs", href: "https://www.texasgulfbank.com/personal-savings-cds-iras/" },
        { label: "Personal Loans", href: "https://www.texasgulfbank.com/loans/" },
        { label: "Online Banking", href: "https://www.texasgulfbank.com/online-and-mobile-banking/" },
        { label: "Zelle®", href: "https://www.texasgulfbank.com/zelle/" },
        { label: "Rates & Fees", href: "/rates-and-fees" },
      ],
    },
    {
      label: "Business",
      href: "https://www.texasgulfbank.com/business-checking/",
      children: [
        { label: "Business Checking", href: "https://www.texasgulfbank.com/business-checking/" },
        { label: "Business Loans", href: "https://www.texasgulfbank.com/business-loans-financing/" },
        { label: "Card Services", href: "https://www.texasgulfbank.com/business-card-services/" },
        { label: "Treasury Services", href: "https://www.texasgulfbank.com/treasury-services-2024/" },
        { label: "Remote Deposit", href: "https://www.texasgulfbank.com/remote-deposit/" },
      ],
    },
    {
      label: "Wealth",
      href: "https://www.texasgulfbank.com/wealth-management/",
      children: [
        { label: "Wealth Management", href: "https://www.texasgulfbank.com/wealth-management/" },
        { label: "Special Needs Trusts", href: "https://www.texasgulfbank.com/safeguarding-your-childs-financial-future-a-special-needs-trust/" },
        { label: "Financial Planning", href: "https://www.texasgulfbank.com/wealth-management/" },
      ],
    },
    {
      label: "About",
      href: "https://www.texasgulfbank.com/about-texas-gulf-bank/",
      children: [
        { label: "Our Story", href: "https://www.texasgulfbank.com/our-story-texas-gulf-bank/" },
        { label: "Leadership", href: "https://www.texasgulfbank.com/our-team/" },
        { label: "Community", href: "https://www.texasgulfbank.com/community-0/" },
        { label: "Blog", href: "/blog" },
        { label: "Locations", href: "/locations/" },
      ],
    },
  ],
} = Astro.props;
---

<header class="site-header bg-white sticky top-0 z-50" data-shrink-header>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full">
    <div class="flex items-center justify-between h-full">
      <!-- Logo -->
      <div class="flex flex-col items-start justify-center gap-0">
        <a href="/" class="flex items-center group" aria-label="Texas Gulf Bank home">
          <img src="/logo-navy.png" alt="Texas Gulf Bank" class="logo-img w-auto" />
        </a>
      </div>

      <!-- Desktop Nav with dropdowns -->
      <nav class="hidden lg:flex items-center gap-0.5" aria-label="Main navigation">
        {links.map((item) => (
          <div class="nav-item relative" data-nav-item>
            <a
              href={item.href}
              class:list={[
                "inline-flex items-center gap-1 px-4 py-2 text-sm font-medium rounded-lg transition-colors nav-trigger",
                item.active
                  ? "text-brand-gold-dark bg-brand-gold-pale/30"
                  : "text-brand-text hover:text-brand-navy-light hover:bg-gray-50",
              ]}
              aria-haspopup={item.children?.length ? "true" : undefined}
              aria-expanded={item.children?.length ? "false" : undefined}
              data-nav-trigger
            >
              {item.label}
              {item.children?.length > 0 && (
                <svg class="w-3.5 h-3.5 nav-chevron transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {item.children?.length > 0 && (
              <div class="nav-dropdown absolute left-0 top-full pt-2 w-[300px] invisible" data-nav-dropdown>
                <div class="nav-dropdown-panel rounded-2xl bg-white/95 backdrop-blur-xl border border-brand-navy/10 shadow-[0_24px_60px_rgba(15,23,42,0.18)] overflow-hidden py-2">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="menu-link group/link flex items-center justify-between gap-3 px-5 py-3 text-sm text-brand-text hover:text-brand-navy transition-all duration-300"
                    >
                      <span class="relative">
                        {child.label}
                        <span class="menu-link-underline"></span>
                      </span>
                      <svg class="menu-link-arrow w-4 h-4 text-brand-aqua shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- CTA + Mobile Toggle -->
      {showCta && (
        <div class="flex items-center gap-3">
          <a
            href="https://www.netteller.com/login2008/Authentication/Views/Login.aspx?returnUrl=%2Ftexasgulfbank"
            class="hidden sm:inline-flex items-center gap-2 bg-brand-gold text-brand-navy px-5 py-2.5 rounded-lg text-sm font-bold hover:bg-brand-gold-light transition-colors shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Online Banking
          </a>
          {showHamburger && (
            <button
              class="menu-toggle lg:hidden p-2 rounded-lg transition-colors"
              aria-label="Menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
              data-menu-toggle
            >
              <svg class="icon-burger w-6 h-6 text-brand-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg class="icon-close w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M6 18L18 6" />
              </svg>
            </button>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Mobile full-screen menu overlay (covers the header bar entirely) -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mobile-menu-top">
        <img src="/logo-white.png" alt="Texas Gulf Bank" class="mobile-menu-logo" />
      </div>

      <nav class="mobile-menu-nav" aria-label="Mobile navigation">
        {links.map((item) => (
          <div class="menu-section">
            <h3 class="menu-section-title font-display">{item.label}</h3>
            <ul class="menu-links">
              {item.children?.map((child) => (
                <li><a href={child.href}>{child.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <!-- Bottom: Online Banking CTA (header CTA is hidden on phones) + trust line -->
      <div class="mobile-menu-bottom">
        <a
          href="https://www.netteller.com/login2008/Authentication/Views/Login.aspx?returnUrl=%2Ftexasgulfbank"
          class="inline-flex items-center justify-center gap-2 bg-brand-gold text-brand-navy px-6 py-3 rounded-lg text-sm font-bold hover:bg-brand-aqua transition-colors shadow-sm w-full sm:w-auto"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Online Banking
        </a>
        <p class="text-xs text-white/60">Member FDIC · Equal Housing Lender</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    height: 4.75rem;
    border-bottom: 1px solid #f3f4f6;
    transition: height 0.28s ease, box-shadow 0.28s ease, border-radius 0.28s ease,
      margin 0.28s ease, top 0.28s ease, border-color 0.28s ease,
      background-color 0.28s ease;
  }
  .logo-img {
    height: 1.75rem;
    transition: height 0.28s ease;
  }
  .site-header.is-scrolled {
    height: 3.25rem;
    top: 0.5rem;
    margin-inline: 0.75rem;
    border-radius: 9999px;
    border-bottom-color: transparent;
    background-color: transparent; /* frosted layer lives on ::before so backdrop-filter doesn't trap the fixed mobile menu */
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.14);
  }
  /* Frosted pill background — kept off the header element itself: backdrop-filter
     on an element makes it the containing block for position:fixed descendants,
     which would trap the mobile menu overlay inside the pill (blue bar + frozen page). */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgba(255, 255, 255, 0.88);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity 0.28s ease;
    z-index: -1;
    pointer-events: none;
  }
  .site-header.is-scrolled::before {
    opacity: 1;
  }
  @media (min-width: 640px) {
    .site-header.is-scrolled {
      margin-inline: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .site-header.is-scrolled {
      top: 0.75rem;
      margin-inline: 2rem;
    }
  }
  .site-header.is-scrolled .logo-img {
    height: 1.5rem;
  }
  @media (min-width: 1024px) {
    .site-header {
      height: 5rem;
    }
    .logo-img {
      height: 2.5rem;
    }
    .site-header.is-scrolled {
      height: 3.5rem;
    }
    .site-header.is-scrolled .logo-img {
      height: 2rem;
    }
  }

  /* ── Desktop dropdown nav (SouthWest Bank style) ── */
  .nav-dropdown {
    transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out, visibility 0.3s ease-in-out;
    opacity: 0;
    transform: translateY(-12px);
    visibility: hidden;
    pointer-events: none;
  }
  .nav-item.is-open .nav-dropdown {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
  }
  /* Frosted panel reveal */
  .nav-dropdown-panel {
    transform: translateY(-8px);
    transition: transform 0.3s ease-in-out;
  }
  .nav-item.is-open .nav-dropdown-panel {
    transform: translateY(0);
  }
  /* Trigger hover: pill highlight like SWB's category hover */
  .nav-trigger {
    position: relative;
    transition: background-color 0.3s ease-in-out, color 0.3s ease-in-out;
  }
  .nav-trigger:hover,
  .nav-item.is-open .nav-trigger {
    background-color: rgba(25, 41, 75, 0.06);
    color: var(--color-brand-navy);
  }
  .nav-item.is-open .nav-trigger {
    color: var(--color-brand-blue);
  }
  .nav-item.is-open .nav-chevron {
    transform: rotate(180deg);
    color: var(--color-brand-blue);
  }
  /* Link rows: hairline divider that fades, arrow slides in on hover */
  .menu-link {
    position: relative;
  }
  .menu-link::after {
    content: "";
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 0;
    height: 1px;
    background: rgba(9, 26, 52, 0.08);
    transition: background-color 0.3s ease-in-out;
  }
  .menu-link:last-child::after {
    display: none;
  }
  .menu-link:hover::after {
    background: transparent;
  }
  .menu-link-underline {
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--color-brand-aqua);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease-in-out;
  }
  .menu-link:hover .menu-link-underline {
    transform: scaleX(1);
  }
  .menu-link-arrow {
    opacity: 0;
    transform: translateX(-16px);
    transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
  }
  .menu-link:hover .menu-link-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .menu-link:hover {
    background-color: rgba(57, 182, 211, 0.08);
  }

  /* ── Mobile full-screen menu ── */
  .menu-toggle {
    position: relative;
    z-index: 70;
  }
  .menu-toggle .icon-close {
    display: none;
  }
  .menu-toggle.is-open .icon-burger {
    display: none;
  }
  .menu-toggle.is-open .icon-close {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background-color: var(--color-brand-navy);
    background-image: linear-gradient(135deg, rgba(57, 182, 211, 0.1) 0%, rgba(25, 41, 75, 0) 55%);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0s linear 0.28s;
  }
  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.28s ease;
  }

  .mobile-menu-top {
    display: flex;
    align-items: center;
    height: 4rem;
  }
  .mobile-menu-logo {
    height: 2rem;
    width: auto;
  }
  @media (min-width: 1024px) {
    .mobile-menu-top {
      height: 5rem;
    }
    .mobile-menu-logo {
      height: 2.5rem;
    }
  }

  .mobile-menu-nav {
    padding: 1rem 0 0.75rem;
  }
  .menu-section + .menu-section {
    margin-top: 1.75rem;
  }
  .menu-section-title {
    color: var(--color-brand-aqua);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(57, 182, 211, 0.4);
    margin-bottom: 0.35rem;
  }
  .menu-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-links a {
    display: block;
    padding: 0.4rem 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.02rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color 0.18s ease, padding-left 0.18s ease;
  }
  .menu-links a:hover,
  .menu-links a:focus-visible {
    color: var(--color-brand-aqua);
    padding-left: 0.4rem;
  }

  .mobile-menu-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.5rem 0 2.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header::before,
    .logo-img,
    .nav-dropdown,
    .nav-dropdown-panel,
    .nav-trigger,
    .menu-link,
    .menu-link::after,
    .menu-link-underline,
    .menu-link-arrow {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector("[data-shrink-header]");
  if (header) {
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 16);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // ── Desktop dropdown nav: open on hover, toggle on click, close on outside/Escape ──
  const navItems = [...document.querySelectorAll("[data-nav-item]")];
  let openItem = null;

  function closeDropdowns(except) {
    navItems.forEach((item) => {
      if (item !== except) {
        item.classList.remove("is-open");
        const trigger = item.querySelector("[data-nav-trigger]");
        if (trigger) trigger.setAttribute("aria-expanded", "false");
      }
    });
    if (!except) openItem = null;
  }

  navItems.forEach((item) => {
    const trigger = item.querySelector("[data-nav-trigger]");
    const dropdown = item.querySelector("[data-nav-dropdown]");
    if (!trigger || !dropdown) return;

    // Hover open/close (desktop)
    item.addEventListener("mouseenter", () => {
      closeDropdowns(item);
      item.classList.add("is-open");
      openItem = item;
      trigger.setAttribute("aria-expanded", "true");
    });
    item.addEventListener("mouseleave", () => {
      // Only close on leave if the pointer is no longer inside the item (incl. dropdown)
      const rect = item.getBoundingClientRect();
      const x = event.clientX, y = event.clientY;
      if (x < rect.left || x > rect.right || y < rect.top || y > rect.bottom) {
        item.classList.remove("is-open");
        trigger.setAttribute("aria-expanded", "false");
        openItem = null;
      }
    });

    // Click toggles (touch/keyboard parity)
    trigger.addEventListener("click", (e) => {
      e.preventDefault(); // prevent navigating away; dropdown reveals pages
      const willOpen = !item.classList.contains("is-open");
      closeDropdowns(item);
      if (willOpen) {
        item.classList.add("is-open");
        openItem = item;
        trigger.setAttribute("aria-expanded", "true");
      } else {
        openItem = null;
      }
    });
  });

  // Close on outside click
  document.addEventListener("click", (e) => {
    if (!e.target.closest("[data-nav-item]")) {
      closeDropdowns();
    }
  });
  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeDropdowns();
  });

  // Mobile full-screen menu toggle
  const menuToggle = document.querySelector("[data-menu-toggle]");
  const mobileMenu = document.getElementById("mobile-menu");
  if (menuToggle && mobileMenu) {
    const closeMenu = () => {
      document.body.classList.remove("menu-open");
      mobileMenu.classList.remove("is-open");
      mobileMenu.setAttribute("aria-hidden", "true");
      menuToggle.classList.remove("is-open");
      menuToggle.setAttribute("aria-expanded", "false");
    };
    const openMenu = () => {
      document.body.classList.add("menu-open");
      mobileMenu.classList.add("is-open");
      mobileMenu.setAttribute("aria-hidden", "false");
      menuToggle.classList.add("is-open");
      menuToggle.setAttribute("aria-expanded", "true");
    };
    menuToggle.addEventListener("click", () => {
      if (mobileMenu.classList.contains("is-open")) {
        closeMenu();
      } else {
        openMenu();
      }
    });
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) closeMenu();
    });
  }
</script>
