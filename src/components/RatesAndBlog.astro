---
import { getCollection } from "astro:content";
import RateTable from "./RateTable.astro";

const allPosts = await getCollection("blog");
allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestPosts = allPosts.slice(0, 3);
const readTime = (post) => {
  const words = (post.body || "").trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 220));
};
---

<section class="bg-brand-cream py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-black text-brand-text leading-[1.08] tracking-tight text-balance">
          Current rates,<br /><span class="text-brand-blue">no runaround.</span>
        </h2>
        <div class="mt-8 max-w-xl">
          <RateTable />
        </div>
      </div>

      <div class="lg:col-span-5">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-black text-brand-text leading-[1.08] tracking-tight text-balance">Worth knowing.</h2>

        <div class="mt-8 border-t border-brand-navy/15">
          {latestPosts.map((post) => (
            <a href={`/blog/${post.id}`} class="block group py-6 border-b border-brand-navy/10">
              <div class="flex items-center gap-2 text-xs text-brand-muted mb-3 font-sans">
                <span class="font-semibold text-brand-gold-dark">{post.data.category}</span>
                <span aria-hidden="true">·</span>
                <span>{post.data.date}</span>
                <span aria-hidden="true">·</span>
                <span>{readTime(post)} min read</span>
              </div>
              <h3 class="font-display text-xl font-semibold leading-snug text-brand-text group-hover:text-brand-navy-light transition-colors">{post.data.title}</h3>
              <span class="inline-block mt-2 text-brand-navy-light text-sm font-semibold group-hover:text-brand-gold-dark transition-colors underline underline-offset-2">Read article</span>
            </a>
          ))}
        </div>

        <a href="/blog" class="inline-block mt-6 text-brand-navy-light font-semibold hover:text-brand-gold-dark transition-colors text-sm underline underline-offset-2">
          View all posts
        </a>
      </div>
    </div>
  </div>
</section>
