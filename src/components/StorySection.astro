---
// StorySection.astro — Brand story with a real, unposed feel
const { home } = Astro.props;
---

<section class="bg-white py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-black text-brand-text leading-[1.08] tracking-tight text-balance">
          {home.story_headline || "Over a century of"}
          <span class="block text-brand-navy-light">{home.story_headline_accent || "Texas banking"}</span>
        </h2>
        <p class="mt-6 text-brand-muted text-base sm:text-lg leading-relaxed max-w-xl">
          {home.story_body_1 || "Texas Gulf Bank is an independently owned and operated community bank with locations in Harris, Galveston, and Brazoria counties. For over 100 years, we've been a strong and financially secure member of the Texas Gulf Coast community."}
        </p>
        <p class="mt-4 text-brand-muted text-base sm:text-lg leading-relaxed max-w-xl">
          {home.story_body_2 || "We pride ourselves on personal relationships — you'll always speak face-to-face with a local decision-maker. Our team members live and work in the same communities where our branches are located."}
        </p>

        <div class="mt-10 grid grid-cols-3 gap-6 sm:gap-10 border-t border-brand-navy/10 pt-8">
          <div>
            <p class="text-3xl sm:text-4xl font-bold text-brand-navy-light">{home.story_stat_1_number || "100+"}</p>
            <p class="text-sm text-brand-muted mt-1">{home.story_stat_1_label || "Years serving Texas"}</p>
          </div>
          <div>
            <p class="text-3xl sm:text-4xl font-bold text-brand-navy-light">{home.story_stat_2_number || "12"}</p>
            <p class="text-sm text-brand-muted mt-1">{home.story_stat_2_label || "Community branches"}</p>
          </div>
          <div>
            <p class="text-3xl sm:text-4xl font-bold text-brand-navy-light">{home.story_stat_3_number || "3"}</p>
            <p class="text-sm text-brand-muted mt-1">{home.story_stat_3_label || "Coastal counties"}</p>
          </div>
        </div>

        <a href="https://www.texasgulfbank.com/about-texas-gulf-bank/" class="inline-block mt-10 text-brand-navy-light font-semibold hover:text-brand-gold transition-colors underline underline-offset-4">
          Read our full story
        </a>
      </div>

      <div class="lg:col-span-5">
        <blockquote class="border-l-4 border-brand-gold bg-brand-warm p-6 sm:p-8">
          <p class="text-lg sm:text-xl leading-relaxed text-brand-text font-sans">
            "Building relationships that last generations — that's what community banking is all about."
          </p>
          <footer class="mt-5 text-sm text-brand-muted font-sans">
            The Texas Gulf Bank team, serving the Gulf Coast since 1920
          </footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>
