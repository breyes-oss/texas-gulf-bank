---
import { getEntry } from "astro:content";

interface Props {
  compact?: boolean;
  showHeader?: boolean;
  class?: string;
  /** Render only the rates.yaml section with this id (e.g. "money-market", "cd-fixed") */
  section?: string;
}

const { compact = false, showHeader = true, class: className = "", section } = Astro.props;
const entry = await getEntry("data", "rates");
const rates = entry?.data;

if (!rates) {
  throw new Error("Missing rates data at src/content/data/rates.yaml");
}

const sectionData = section ? rates.sections?.find((s) => s.id === section) : undefined;
---

<div class:list={["rate-table", className]}>
  {showHeader && (
    <div class:list={[compact ? "mb-4" : "mb-6"]}>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-gold-dark">Current Rates</p>
      {rates.published && (
        <p class:list={[compact ? "mt-1 text-xs text-brand-muted" : "mt-2 text-sm text-brand-muted"]}>
          {sectionData ? `${sectionData.title} — rates published ${rates.published}.` : `Featured annual percentage yields published ${rates.published}.`}
        </p>
      )}
    </div>
  )}

  {sectionData ? (
    <Fragment>
      <!-- Single rate-sheet section (product page embed) -->
      <div class="overflow-x-auto rounded-lg border border-brand-navy/10">
      <table class="w-full text-sm bg-white">
        <thead>
          <tr class="bg-brand-navy text-white">
            {sectionData.columns.map((c, i) => (
              <th scope="col" class:list={["px-4 py-3 text-left font-display font-bold", i > 0 && "text-right"]}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {sectionData.rows.map((row) => (
            <tr class="border-b border-brand-navy/10 last:border-b-0">
              {row.map((cell, i) => (
                <td class:list={["px-4 py-2.5", i === 0 ? "font-medium text-brand-text" : "text-right font-display font-semibold text-brand-blue"]}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {sectionData.note && <p class="mt-3 text-xs text-brand-muted leading-relaxed">{sectionData.note}</p>}
    </Fragment>
  ) : (
    <>
      <div class:list={[compact ? "border-y border-brand-navy/15" : "border-y border-brand-navy/15"]}>
        {rates.items.map((rate) => (
          <div class:list={[
            "grid grid-cols-[1fr_auto] gap-5 items-center border-b last:border-b-0 border-brand-navy/10",
            compact ? "py-3.5" : "py-5"
          ]}>
            <div>
              <p class:list={["font-semibold text-brand-text", compact && "text-sm"]}>{rate.name}</p>
              {rate.detail && <p class="text-sm text-brand-muted mt-0.5">{rate.detail}</p>}
            </div>
            <div class="text-right">
              <p class:list={[
                "font-display font-semibold text-brand-blue",
                compact ? "text-2xl" : "text-3xl"
              ]}>{rate.value}</p>
              <p class="text-[11px] font-semibold tracking-[0.16em] text-brand-muted">APY</p>
            </div>
          </div>
        ))}
      </div>

      {(rates.sections?.length ?? 0) > 0 && !compact && (
        <div class="mt-8 space-y-8">
          {rates.sections.map((s) => (
            <div id={`rates-${s.id}`}>
              <h3 class="font-display font-bold text-brand-navy">{s.title}</h3>
              <div class="mt-3 overflow-x-auto rounded-lg border border-brand-navy/10">
                <table class="w-full min-w-[420px] text-sm bg-white">
                  <thead>
                    <tr class="bg-brand-navy text-white">
                      {s.columns.map((c, i) => (
                        <th scope="col" class:list={["px-4 py-2.5 text-left font-display font-bold", i > 0 && "text-right"]}>{c}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.rows.map((row) => (
                      <tr class="border-b border-brand-navy/10 last:border-b-0">
                        {row.map((cell, i) => (
                          <td class:list={["px-4 py-2.5", i === 0 ? "font-medium text-brand-text" : "text-right font-display font-semibold text-brand-blue"]}>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {s.note && <p class="mt-2 text-xs text-brand-muted leading-relaxed">{s.note}</p>}
            </div>
          ))}
          {rates.sections_footnote && (
            <p class="text-xs text-brand-muted leading-relaxed">{rates.sections_footnote}</p>
          )}
        </div>
      )}
    </>
  )}

  {rates.disclaimer && (
    <p class:list={["text-brand-muted leading-relaxed", compact ? "mt-3 text-[11px]" : "mt-5 text-xs"]}>
      {rates.disclaimer}
    </p>
  )}

  {rates.full_rates_url && (
    <a
      href={rates.full_rates_url}
      class:list={[
        "inline-flex items-center gap-2 font-semibold text-brand-navy-light hover:text-brand-gold-dark transition-colors",
        compact ? "mt-4 text-sm" : "mt-6 text-sm"
      ]}
    >
      View complete rates and disclosures
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  )}
</div>
