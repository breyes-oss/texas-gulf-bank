---
import {
  OFFICIAL_RATES_URL,
  cdAsOfText,
  featuredRates,
  getRateGroup,
  loadRateCatalog,
  showsCdRates,
  type RateCatalog,
  type RateGroup,
} from "../lib/rates";

interface Props {
  compact?: boolean;
  showHeader?: boolean;
  class?: string;
  /** Product group id, for example "money-market" or "cd-fixed". */
  section?: string;
  catalog?: RateCatalog;
}

const { compact = false, showHeader = true, class: className = "", section, catalog: provided } = Astro.props;
const catalog = provided ?? (await loadRateCatalog());
const featured = featuredRates(catalog);
const group = section ? getRateGroup(catalog, section) : undefined;
const groups = section ? [] : [...catalog.groups].sort((a, b) => a.sortOrder - b.sortOrder);
const asOf = cdAsOfText(catalog);
const showFeaturedAsOf = !section && showsCdRates(undefined, true);

function columns(rateGroup: RateGroup): string[] {
  return [rateGroup.tierLabel, "Interest Rate", "APY"];
}
---

<div class:list={["rate-table", className]}>
  <p class="placeholder-callout" role="note">Placeholder rates, not current offers.</p>
  {showHeader && (
    <div class:list={[compact ? "mb-4" : "mb-6"]}>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-gold-dark">Placeholder rates</p>
    </div>
  )}

  {group ? (
    <Fragment>
      <div class="overflow-x-auto rounded-lg border border-brand-navy/10">
        <table class="w-full text-sm bg-white">
          <thead>
            <tr class="bg-brand-navy text-white">
              {columns(group).map((column, index) => (
                <th scope="col" class:list={["px-4 py-3 text-left font-display font-bold", index > 0 && "text-right"]}>{column}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {group.rows.map((row) => (
              <tr class="border-b border-brand-navy/10 last:border-b-0">
                <td class="px-4 py-2.5 font-medium text-brand-text">{row.label}</td>
                <td class="px-4 py-2.5 text-right font-display font-semibold text-brand-blue">{row.interestRate}</td>
                <td class="px-4 py-2.5 text-right font-display font-semibold text-brand-blue">{row.apy}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {group.id === "cd-fixed" && <p class="mt-3 text-sm font-semibold text-brand-navy">{asOf}</p>}
      {group.note && <p class="mt-3 text-xs text-brand-muted leading-relaxed">{group.note}</p>}
    </Fragment>
  ) : (
    <>
      <div class="border-y border-brand-navy/15">
        {featured.map((rate) => (
          <div class:list={[
            "grid grid-cols-[1fr_auto] gap-5 items-center border-b last:border-b-0 border-brand-navy/10",
            compact ? "py-3.5" : "py-5"
          ]}>
            <div>
              <p class:list={["font-semibold text-brand-text", compact && "text-sm"]}>{rate.name}</p>
              {rate.detail && <p class="text-sm text-brand-muted mt-0.5">{rate.detail}</p>}
            </div>
            <div class="text-right">
              <p class:list={[
                "font-display font-semibold text-brand-blue",
                compact ? "text-2xl" : "text-3xl"
              ]}>{rate.value}</p>
              <p class="text-[11px] font-semibold tracking-[0.16em] text-brand-muted">APY</p>
            </div>
          </div>
        ))}
      </div>
      {showFeaturedAsOf && <p class:list={["font-semibold text-brand-navy", compact ? "mt-3 text-sm" : "mt-4 text-sm"]}>{asOf}</p>}

      {groups.length > 0 && !compact && (
        <div class="mt-8 space-y-8">
          {groups.map((rateGroup) => (
            <div id={`rates-${rateGroup.id}`}>
              <h3 class="font-display font-bold text-brand-navy">{rateGroup.title}</h3>
              <div class="mt-3 overflow-x-auto rounded-lg border border-brand-navy/10">
                <table class="w-full min-w-[420px] text-sm bg-white">
                  <thead>
                    <tr class="bg-brand-navy text-white">
                      {columns(rateGroup).map((column, index) => (
                        <th scope="col" class:list={["px-4 py-2.5 text-left font-display font-bold", index > 0 && "text-right"]}>{column}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {rateGroup.rows.map((row) => (
                      <tr class="border-b border-brand-navy/10 last:border-b-0">
                        <td class="px-4 py-2.5 font-medium text-brand-text">{row.label}</td>
                        <td class="px-4 py-2.5 text-right font-display font-semibold text-brand-blue">{row.interestRate}</td>
                        <td class="px-4 py-2.5 text-right font-display font-semibold text-brand-blue">{row.apy}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {rateGroup.id === "cd-fixed" && <p class="mt-2 text-sm font-semibold text-brand-navy">{asOf}</p>}
              {rateGroup.note && <p class="mt-2 text-xs text-brand-muted leading-relaxed">{rateGroup.note}</p>}
            </div>
          ))}
        </div>
      )}
    </>
  )}

  <p class:list={["text-brand-muted leading-relaxed", compact ? "mt-3 text-[11px]" : "mt-5 text-xs"]}>[Placeholder] Rates shown are examples only, not current offers.</p>

  <a
    href={OFFICIAL_RATES_URL}
    class:list={[
      "inline-flex items-center gap-2 font-semibold text-brand-navy-light hover:text-brand-gold-dark transition-colors",
      compact ? "mt-4 text-sm" : "mt-6 text-sm"
    ]}
  >
    View complete rates and disclosures
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
  </a>
</div>
