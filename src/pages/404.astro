---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="This concept page does not exist.">
  <section class="bg-brand-cream">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="font-display text-4xl font-black text-brand-navy">Page not found</h1>
      <p class="mt-4 text-brand-muted">That page is not on this concept site.</p>
      <p class="mt-6"><a class="font-semibold text-brand-navy-light underline underline-offset-2" href="/">Back to the home page</a></p>
    </div>
  </section>
</Layout>
