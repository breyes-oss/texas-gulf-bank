---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import RateTable from "../components/RateTable.astro";

const entry = await getEntry("products", "personal-savings");
const d = entry?.data;
if (!d) throw new Error("Missing products/personal-savings.yaml");

// Full rate sheet (sections) for the rates modal — same source as RateTable
const ratesEntry = await getEntry("data", "rates");
const ratesData = ratesEntry?.data;

const featured = d.products; // Personal Savings, CD, IRA, Money Market

// Rate-sheet section shown inside each product's panel (from rates.yaml)
const RATE_SECTIONS = {
  "personal-savings": "savings",
  "certificate-of-deposit": "cd-fixed",
  "ira": "ira-fixed",
  "money-market": "money-market",
};

// Top advertised APY per product (drives the "up to" line)
const RATE_UP_TO = {
  "personal-savings": "0.40%",
  "certificate-of-deposit": "3.45%",
  "ira": "3.45%",
  "money-market": "1.66%",
};
---

<Layout
  title="Savings Accounts, CDs & IRAs — Texas Gulf Bank"
  description="Compare Texas Gulf Bank savings options: accessible Personal Savings, fixed-rate Certificates of Deposit, and IRAs for retirement. Plus Gulf Rewards Savings and Health Savings Accounts. Open online or at any of our nine banking centers."
>
  <!-- Hero -->
  <section class="bg-gradient-to-r from-brand-navy via-brand-navy-mid to-brand-aqua text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.05] tracking-tight text-balance max-w-3xl">
        Saving is simple. Choosing where is the hard part.
      </h1>
      <p class="mt-5 text-lg text-white/85 max-w-2xl text-balance leading-relaxed">
        Money you'll need soon belongs in savings. Money you can set aside for years
        should be earning at its full potential. We'll help you figure out which is which —
        then open the right account in minutes.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href="#accounts" class="inline-flex items-center justify-center gap-2 bg-brand-gold text-brand-navy px-7 py-3.5 rounded-lg text-base font-bold hover:bg-white transition-colors">
          Find my account
        </a>
        <a href="#compare" class="inline-flex items-center justify-center gap-2 border border-white/35 text-white px-7 py-3.5 rounded-lg text-base font-semibold hover:bg-white/10 transition-colors">
          Compare them side by side
        </a>
      </div>

      <!-- 3-question picker -->
      <div id="picker" class="mt-10 max-w-xl bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-5 sm:p-6">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-gold">When will you need the money?</p>
        <div class="mt-4 grid sm:grid-cols-3 gap-2.5">
          <button type="button" data-picker-answer="personal-savings" class="text-left bg-white/10 hover:bg-white/25 border border-white/25 rounded-lg px-4 py-3 transition-colors">
            <span class="block font-display font-bold text-white">Soon</span>
            <span class="block text-xs text-white/75 mt-0.5">Any day now</span>
          </button>
          <button type="button" data-picker-answer="money-market" class="text-left bg-white/10 hover:bg-white/25 border border-white/25 rounded-lg px-4 py-3 transition-colors">
            <span class="block font-display font-bold text-white">Don't know</span>
            <span class="block text-xs text-white/75 mt-0.5">$500+ to park</span>
          </button>
          <button type="button" data-picker-answer="certificate-of-deposit" class="text-left bg-white/10 hover:bg-white/25 border border-white/25 rounded-lg px-4 py-3 transition-colors">
            <span class="block font-display font-bold text-white">Years from now</span>
            <span class="block text-xs text-white/75 mt-0.5">A set date</span>
          </button>
        </div>
        <p id="picker-result" class="hidden mt-4 text-sm text-white/90"></p>
      </div>
    </div>
  </section>

  <!-- Featured panels -->
  <section id="accounts" class="py-14 lg:py-20 bg-brand-warm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-black text-brand-text tracking-tight text-balance max-w-2xl leading-[1.1]">
        Match the account to your timeline.
      </h2>
      <div class="mt-10 grid lg:grid-cols-3 gap-6">
        {featured.map((p, i) => (
          <article id={`panel-${p.id}`} class:list={["bg-white border border-brand-navy/10 rounded-lg overflow-hidden flex flex-col scroll-mt-24", i === 1 && "ring-2 ring-brand-gold"]}>
            <div class="p-6 sm:p-7 flex-1">
              <div class="flex items-center justify-between gap-3">
                <h3 class="font-display text-xl font-bold text-brand-navy">{p.name}</h3>
                {i === 1 && (
                  <span class="shrink-0 inline-flex rounded-full bg-brand-gold-pale border border-brand-gold/40 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-brand-gold-dark">Best rate</span>
                )}
              </div>
              <p class="mt-1.5 text-sm text-brand-muted italic">{p.tagline}</p>

              <div class="mt-5 flex items-baseline gap-2">
                <span class="text-sm text-brand-muted">from</span>
                <span class="font-display text-3xl font-black text-brand-rate">{p.min_opening}</span>
              </div>
              {p.fee_note && <p class="mt-1 text-xs text-brand-muted leading-relaxed">{p.fee_note}</p>}

              {p.best_for && (
                <p class="mt-4 text-sm text-brand-text flex gap-2">
                  <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-rate" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                  <span><span class="font-semibold">Right for:</span> {p.best_for}</span>
                </p>
              )}

              <details class="group mt-5">
                <summary class="lg:hidden cursor-pointer list-none text-sm font-semibold text-brand-navy-light hover:text-brand-gold-dark transition-colors">
                  What's included <span class="group-open:hidden">▾</span><span class="hidden group-open:inline">▴</span>
                </summary>
                <ul class="hidden group-open:block lg:block mt-3 lg:mt-0 space-y-2.5">
                  {p.highlights.map((h) => (
                    <li class="flex gap-2.5 text-sm text-brand-text leading-relaxed">
                      <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-rate" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                      {h}
                    </li>
                  ))}
                </ul>
              </details>

            </div>

            <div class="px-6 sm:px-7 pb-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-brand-navy/5 pt-4 mt-4">
              <a href={p.open_url} class="inline-flex items-center justify-center gap-2 bg-brand-navy text-white px-5 py-2.5 rounded-lg text-sm font-bold hover:bg-brand-navy-light transition-colors">
                {p.id === "ira" ? "Talk to a banker" : "Open this account"}
              </a>
              <button
                type="button"
                data-details-trigger={p.id}
                class="inline-flex items-center gap-2 text-brand-navy-light underline underline-offset-2 hover:text-brand-gold-dark transition-colors text-sm font-semibold"
              >
                Rates & details
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="compare" class="py-14 lg:py-20 bg-white scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-black text-brand-text tracking-tight text-balance leading-[1.1] max-w-2xl">
        All four, side by side.
      </h2>
      <p class="mt-3 text-brand-muted max-w-2xl">Same bank, same FDIC insurance — the difference is how long you can set the money aside. {d.published}.</p>

      <div class="mt-8 overflow-x-auto rounded-lg border border-brand-navy/10">
        <table class="w-full min-w-[720px] text-sm bg-white">
          <caption class="sr-only">Savings, CD and IRA account comparison</caption>
          <thead>
            <tr class="bg-brand-navy text-white">
              <th scope="col" class="text-left px-5 py-4 font-display font-bold w-[22%]">Account</th>
              {featured.map((p) => (
                <th scope="col" class="text-left px-5 py-4 font-display font-bold">{p.name}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-brand-navy/10 bg-brand-cream/60">
              <th scope="row" class="text-left px-5 py-4 font-semibold text-brand-gold-dark">Monthly fee</th>
              {featured.map((p) => (
                <td class="px-5 py-4 align-top">
                  <span class="font-display font-black text-base text-brand-blue">{p.monthly_fee}</span>
                  {p.fee_note && <span class="block mt-0.5 text-xs text-brand-muted leading-snug">{p.fee_note}</span>}
                </td>
              ))}
            </tr>
            {d.compare_rows.map((row) => (
              <tr class="border-b border-brand-navy/10 last:border-b-0 hover:bg-brand-warm/60 transition-colors">
                <th scope="row" class="text-left px-5 py-3.5 font-semibold text-brand-text">{row.label}</th>
                {row.values.map((v) => (
                  <td class:list={["px-5 py-3.5 align-top", v === "—" ? "text-brand-muted" : "text-brand-text"]}>{v}</td>
                ))}
              </tr>
            ))}
            <tr>
              <td class="px-5 py-4"></td>
              {featured.map((p) => (
                <td class="px-5 py-4">
                  <a href={p.open_url} class="inline-flex items-center justify-center bg-brand-gold text-brand-navy px-4 py-2 rounded-lg text-xs font-bold hover:bg-brand-gold-light transition-colors whitespace-nowrap">
                    {p.id === "ira" ? "Talk to a banker" : "Open"}
                  </a>
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
      {d.disclaimer_short && <p class="mt-4 text-xs text-brand-muted max-w-3xl">{d.disclaimer_short}</p>}
    </div>
  </section>

  <!-- Secondary products -->
  <section class="py-14 lg:py-20 bg-brand-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-black text-brand-text tracking-tight text-balance max-w-2xl leading-[1.1]">
        Two more accounts worth knowing about.
      </h2>
      <div class="mt-10 grid md:grid-cols-2 gap-6">
        {d.secondary.map((s) => (
          <article class="bg-white border border-brand-navy/10 rounded-lg p-6 sm:p-7 flex flex-col">
            <h3 class="font-display text-xl font-bold text-brand-navy">{s.name}</h3>
            <p class="mt-1.5 text-sm text-brand-muted italic">{s.tagline}</p>
            <ul class="mt-5 space-y-2.5 flex-1">
              {s.points.map((pt) => (
                <li class="flex gap-2.5 text-sm text-brand-text leading-relaxed">
                  <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-rate" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                  {pt}
                </li>
              ))}
            </ul>
            <div class="mt-6 pt-4 border-t border-brand-navy/5">
              <button type="button" data-disclosure-trigger={s.id} class="text-sm font-semibold text-brand-navy-light underline underline-offset-2 hover:text-brand-gold-dark transition-colors">
                Account details
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-brand-navy py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl sm:text-4xl font-black text-white tracking-tight text-balance leading-[1.1]">
        Still deciding? That's a conversation, not a quiz.
      </h2>
      <p class="mt-4 text-lg text-white/80 max-w-xl mx-auto text-balance">
        Tell a Branch Banking Specialist what the money is for and when you'll need it.
        They'll point you to the right account — and tell you honestly if it's one you don't need.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://www.texasgulfbank.com/contact-texas-gulf-bank/" class="inline-flex items-center justify-center gap-2 bg-brand-gold text-brand-navy px-8 py-3.5 rounded-lg text-base font-bold hover:bg-white transition-colors">
          Talk to a banker
        </a>
        <a href="/locations/" class="inline-flex items-center justify-center gap-2 border border-white/30 text-white px-8 py-3.5 rounded-lg text-base font-semibold hover:bg-white/10 transition-colors">
          Find a banking center
        </a>
      </div>
      <p class="mt-6 text-sm text-white/70">Prefer to talk it through? <a href="tel:8004677216" class="font-bold text-brand-gold underline underline-offset-2">800.467.7216</a></p>
    </div>
  </section>
</Layout>

<!-- Merged modal: Rates & details with tabs -->
<div id="disclosure-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-labelledby="disclosure-title">
  <div class="absolute inset-0 bg-brand-navy/70 backdrop-blur-sm" data-disclosure-close></div>
  <div class="relative max-w-2xl mx-auto mt-[6vh] mb-10 bg-white rounded-xl shadow-2xl max-h-[86vh] flex flex-col">
    <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-4 border-b border-brand-navy/10">
      <div>
        <p class="text-xs font-bold uppercase tracking-wide text-brand-gold-dark">Rates & details</p>
        <h2 id="disclosure-title" class="mt-1 font-display text-xl sm:text-2xl font-black text-brand-navy" data-disclosure-name>Account</h2>
      </div>
      <button type="button" data-disclosure-close aria-label="Close rates and details" class="shrink-0 w-9 h-9 rounded-full border border-brand-navy/15 text-brand-text hover:bg-brand-cream transition-colors flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="px-6 pt-4 flex gap-2" role="tablist">
      <button type="button" role="tab" data-tab="rates" aria-selected="true" class="px-4 py-2 rounded-lg text-sm font-bold bg-brand-navy text-white">Rates</button>
      <button type="button" role="tab" data-tab="details" aria-selected="false" class="px-4 py-2 rounded-lg text-sm font-semibold border border-brand-navy/15 text-brand-text hover:bg-brand-cream">Account details</button>
    </div>
    <div class="px-6 py-5 overflow-y-auto text-sm text-brand-text leading-relaxed space-y-5" data-disclosure-body role="tabpanel"></div>
    <div class="px-6 py-4 border-t border-brand-navy/10 flex flex-wrap gap-3 justify-between items-center">
      <p class="text-xs text-brand-muted">APYs published {d.published}.</p>
      <div class="flex gap-3">
        <a href="/rates-and-fees" class="text-sm font-semibold text-brand-navy-light underline underline-offset-2 hover:text-brand-gold-dark transition-colors">View all rates →</a>
        <a href="tel:8004677216" class="text-sm font-semibold text-brand-navy-light underline underline-offset-2 hover:text-brand-gold-dark transition-colors">Call 800.467.7216</a>
      </div>
    </div>
  </div>
</div>

<script>
  const ALL_ACCOUNTS = JSON.parse(document.getElementById("__ACCOUNTS_JSON__")?.textContent || "[]");
  const RATES_SECTIONS = JSON.parse(document.getElementById("__RATES_SECTIONS__")?.textContent || "[]");
  const modal = document.getElementById("disclosure-modal");
  const nameEl = modal?.querySelector("[data-disclosure-name]");
  const bodyEl = modal?.querySelector("[data-disclosure-body]");
  const tabButtons = modal ? Array.from(modal.querySelectorAll("[data-tab]")) : [];
  let lastFocus = null;
  let current = null; // { product, rateSectionId, tab }

  function esc(s) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function rateTableHtml(s) {
    let html = `<div class="overflow-x-auto"><table class="w-full max-w-md text-sm"><colgroup><col class="w-1/2"><col class="w-1/4"><col class="w-1/4"></colgroup><thead><tr class="bg-brand-navy text-white">`;
    s.columns.forEach((c, i) => {
      html += `<th scope="col" class="px-4 py-3 ${i === 0 ? "text-left" : "text-right"} font-display font-bold">${esc(c)}</th>`;
    });
    html += `</tr></thead><tbody>`;
    for (const row of s.rows) {
      html += `<tr class="border-b border-brand-navy/10 last:border-b-0">`;
      row.forEach((cell, i) => {
        html += `<td class="px-4 py-2.5 ${i === 0 ? "font-medium text-brand-text" : "text-right font-display font-semibold text-brand-blue"}">${esc(cell)}</td>`;
      });
      html += `</tr>`;
    }
    html += `</tbody></table></div>`;
    if (s.note) html += `<p class="mt-3 text-xs text-brand-muted leading-relaxed">${esc(s.note)}</p>`;
    return html;
  }

  function contextLineHtml(rateSectionId) {
    const lines = {
      "savings": "Personal Savings 0.40% · Gulf Rewards Savings 0.40%",
      "cd-fixed": "1-Year CD 3.45% · 18-Month CD 3.30% · 5-Year CD 2.75%",
      "ira-fixed": "1-Year IRA 3.45% · Variable 18-Month IRA 3.30%",
      "money-market": "Money Market tiers run 0.55% → 1.66% APY · Personal Savings pays 0.40%",
    };
    const line = lines[rateSectionId];
    if (!line) return "";
    return `<p class="mt-4 text-xs text-brand-muted bg-brand-cream border border-brand-navy/10 rounded-lg px-4 py-3"><span class="font-semibold text-brand-text">How this compares:</span> ${esc(line)}. <a href="/rates-and-fees" class="font-semibold text-brand-navy-light underline underline-offset-2">All rates →</a></p>`;
  }

  function detailsHtml(p) {
    let html = "";
    const rows = [
      ["Monthly service charge", p.monthly_fee + (p.fee_note ? ` — ${p.fee_note}` : "")],
      ["Minimum opening deposit", p.min_opening || "—"],
    ];
    html += `<table class="w-full text-sm border-collapse"><tbody>`;
    for (const [k, v] of rows) {
      if (!v) continue;
      html += `<tr class="border-b border-brand-navy/10"><th scope="row" class="text-left py-2.5 pr-4 font-semibold align-top whitespace-nowrap">${k}</th><td class="py-2.5">${esc(v)}</td></tr>`;
    }
    html += `</tbody></table>`;
    if (p.qualify && p.qualify.length > 0 && p.qualify_label) {
      html += `<div><p class="font-semibold text-brand-gold-dark text-xs uppercase tracking-wide">${esc(p.qualify_label)}</p><ul class="mt-2 list-disc pl-4 space-y-1">`;
      for (const q of p.qualify) html += `<li>${esc(q)}</li>`;
      html += `</ul></div>`;
    }
    const details = p.details || [];
    if (details.length > 0) {
      html += `<div><p class="font-semibold text-brand-gold-dark text-xs uppercase tracking-wide">Additional information</p><ul class="mt-2 list-disc pl-4 space-y-1.5">`;
      for (const dt of details) html += `<li>${esc(dt)}</li>`;
      html += `</ul></div>`;
    }
    html += `<div class="bg-brand-cream border border-brand-navy/10 rounded-lg p-4 text-xs text-brand-muted leading-relaxed">
      <p class="font-semibold text-brand-text">Good to know</p>
      <p class="mt-1.5">A complete schedule of fees that may apply to your account is available in the <a class="underline underline-offset-2 font-semibold text-brand-navy-light" href="https://www.texasgulfbank.com/savings-cds-iras-comparison-chart/" target="_blank" rel="noopener">Savings / CDs / IRAs Comparison Chart</a>.</p>
      <p class="mt-2">Contact Texas Gulf Bank at 1-800-467-7216 to obtain a Truth-In-Savings / Reg DD disclosure of terms, conditions, fees, and rate information for any account.</p>
    </div>`;
    if (p.details_url) {
      html += `<p><a href="${esc(p.details_url)}" target="_blank" rel="noopener" class="font-semibold text-brand-navy-light underline underline-offset-2">View full account details on texasgulfbank.com →</a></p>`;
    }
    return html;
  }

  function renderTab() {
    if (!current || !bodyEl) return;
    const { product, rateSectionId, tab } = current;
    if (tab === "rates") {
      const s = RATES_SECTIONS.find((x) => x.id === rateSectionId);
      bodyEl.innerHTML = s ? rateTableHtml(s) + contextLineHtml(rateSectionId) : "<p>Rate information unavailable.</p>";
    } else {
      bodyEl.innerHTML = detailsHtml(product);
    }
  }

  function setTab(tab) {
    if (!current) return;
    current.tab = tab;
    tabButtons.forEach((b) => {
      const active = b.getAttribute("data-tab") === tab;
      b.setAttribute("aria-selected", String(active));
      b.className = active
        ? "px-4 py-2 rounded-lg text-sm font-bold bg-brand-navy text-white"
        : "px-4 py-2 rounded-lg text-sm font-semibold border border-brand-navy/15 text-brand-text hover:bg-brand-cream";
    });
    renderTab();
  }

  function openModal(productId) {
    const p = ALL_ACCOUNTS.find((x) => x.id === productId);
    if (!p || !modal) return;
    lastFocus = document.activeElement;
    current = { product: p, rateSectionId: RATE_SECTION_MAP[productId], tab: "rates" };
    if (nameEl) nameEl.textContent = p.name;
    setTab("rates");
    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    modal.querySelector("button[data-disclosure-close]")?.focus();
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add("hidden");
    document.body.style.overflow = "";
    if (lastFocus) lastFocus.focus();
  }

  const RATE_SECTION_MAP = {
    "personal-savings": "savings",
    "certificate-of-deposit": "cd-fixed",
    "ira": "ira-fixed",
    "money-market": "money-market",
    "gulf-rewards-savings": "savings",
    "hsa": "hsa",
  };

  document.querySelectorAll("[data-details-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => openModal(btn.getAttribute("data-details-trigger")));
  });
  tabButtons.forEach((b) => b.addEventListener("click", () => setTab(b.getAttribute("data-tab"))));
  modal?.querySelectorAll("[data-disclosure-close]").forEach((el) => el.addEventListener("click", closeModal));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) closeModal();
  });

  /* 3-question picker: answer -> highlight + scroll to matching panel */
  const PICKER_MESSAGES = {
    "personal-savings": "Any day now — keep it where you can reach it. Personal Savings is built for exactly that.",
    "money-market": "Not sure yet is fine — a Money Market pays more than savings while you decide, and there's no lock-up.",
    "certificate-of-deposit": "A set date is the CD's whole job — your rate locks in and can't dip for the entire term.",
  };
  document.querySelectorAll("[data-picker-answer]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-picker-answer");
      const result = document.getElementById("picker-result");
      if (result) {
        result.textContent = PICKER_MESSAGES[id] || "";
        result.classList.remove("hidden");
      }
      const panel = document.getElementById(`panel-${id}`);
      panel?.scrollIntoView({ behavior: "smooth", block: "center" });
      if (panel) {
        panel.classList.add("ring-2", "ring-brand-gold");
        setTimeout(() => panel.classList.remove("ring-2", "ring-brand-gold"), 4000);
      }
    });
  });
</script>

