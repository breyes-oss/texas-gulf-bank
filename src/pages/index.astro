---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import FeatureCards from "../components/FeatureCards.astro";
import StorySection from "../components/StorySection.astro";
import RatesAndBlog from "../components/RatesAndBlog.astro";
import CtaSection from "../components/CtaSection.astro";

const pages = await getCollection("pages");
const home = pages.find((p) => p.id === "home")?.data || {};
const locations = await getCollection("locations");
const branchCount = String(locations.length);
const countyCount = String(new Set(locations.map((l) => l.data.region)).size);
---

<Layout title="Texas Gulf Bank — Your Local Community Bank" description="Concept redesign of a community bank site serving Harris, Galveston, and Brazoria counties. Not the official Texas Gulf Bank website.">
  <HeroSection home={home} />
  <FeatureCards />
  <StorySection home={home} branchCount={branchCount} countyCount={countyCount} />
  <RatesAndBlog />
  <CtaSection home={home} />
</Layout>
