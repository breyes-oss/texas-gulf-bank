---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const locations = await getCollection("locations");
const sorted = [...locations].sort((a, b) => a.data.name.localeCompare(b.data.name));

// Group by county for the card list (matches how locals search).
const regions = [...new Set(sorted.map((l) => l.data.region))].sort();

// Serialize only the fields the client needs.
const clientData = sorted.map((l) => ({
  id: l.id,
  name: l.data.name,
  region: l.data.region,
  street: l.data.street,
  suite: l.data.suite || "",
  city: l.data.city,
  state: l.data.state,
  zip: l.data.zip,
  phone: l.data.phone,
  lat: l.data.lat,
  lng: l.data.lng,
  has_drive_thru: l.data.has_drive_thru,
  lobby: l.data.hours.lobby,
}));

const dataJson = JSON.stringify(clientData);
const searchPlaceholder = "Search by city, ZIP, or location name";

// Compact hours summary for cards: "Mon–Fri 9 AM – 5 PM · Sat 9 AM – 12 PM"
function hoursSummary(rows: { days: string; open: string; close: string }[]) {
  return rows.map((r) => `${r.days.replace(" - ", "–")} ${r.open} – ${r.close}`).join(" · ");
}

// Per-day rows so cards can highlight today's hours.
const DAY_ABBR: Record<string, string> = { Mon: "Mon", Tue: "Tue", Wed: "Wed", Thu: "Thu", Fri: "Fri", Sat: "Sat", Sun: "Sun" };
function todayRows(rows: { days: string; open: string; close: string }[]) {
  // Returns map of day-abbr -> "open – close" for range expansion
  const out: Record<string, string> = {};
  for (const row of rows) {
    const parts = row.days.split("-").map((s) => s.trim());
    if (parts.length === 2 && DAY_ABBR[parts[0]] && DAY_ABBR[parts[1]]) {
      const order = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
      let start = order.indexOf(parts[0]);
      const end = order.indexOf(parts[1]);
      if (end < start) start -= 7;
      for (let i = start; i <= end; i++) out[order[(i + 7) % 7]] = `${row.open} – ${row.close}`;
    } else if (DAY_ABBR[parts[0]]) {
      out[parts[0]] = `${row.open} – ${row.close}`;
    }
  }
  return out;
}
---

<Layout
  title="Bank &amp; ATM Locations in Houston, Lake Jackson &amp; the Gulf Coast | Texas Gulf Bank"
  description={`Find a Texas Gulf Bank Banking Center near you in Harris, Galveston, and Brazoria counties. ${sorted.length} branches with lobby and drive-thru hours, phone numbers, directions, and services.`}
>
  <!-- Page header: signature navy→aqua gradient band (brand guide: heroes + key moments) -->
  <section class="bg-gradient-to-r from-brand-navy via-brand-navy-mid to-brand-aqua text-white border-b border-brand-navy/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.05] tracking-tight text-balance">
        Texas Gulf Bank Locations
      </h1>
      <p class="mt-5 text-lg text-white/85 max-w-2xl text-balance">
        {sorted.length} ATM and banking centers across {[...new Set(sorted.map((l) => l.data.region.replace(/ County$/, "")))].sort().join(", ").replace(/, ([^,]+)$/, ", and $1")}&nbsp;
        counties — with local bankers who know your community. Search below, or call
        <a href="tel:8004677216" class="text-brand-gold font-bold underline underline-offset-2">800.467.7216</a>.
      </p>
    </div>
  </section>

  <!-- Search + filters -->
  <section class="py-8 border-b border-brand-navy/10 bg-brand-cream/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <form class="flex flex-col sm:flex-row gap-3" role="search" data-loc-search-form>
        <label for="loc-search" class="sr-only">Search locations</label>
        <input
          id="loc-search"
          type="search"
          placeholder={searchPlaceholder}
          autocomplete="off"
          class="flex-1 rounded-lg border border-brand-navy/15 bg-white px-4 py-3 text-sm text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-aqua"
          data-loc-search
        />
        <button
          type="button"
          data-loc-geolocate
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-brand-navy/15 bg-white px-5 py-3 text-sm font-bold text-brand-navy hover:bg-brand-cream transition-colors"
        >
          <svg class="w-4 h-4 text-brand-aqua" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Use my location
        </button>
      </form>

      <fieldset class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        <legend class="sr-only">Filter locations</legend>
        <label class="inline-flex items-center gap-2 text-brand-text cursor-pointer">
          <input type="checkbox" data-loc-filter="drive_thru" class="accent-brand-aqua w-4 h-4" checked />
          Drive-thru
        </label>
        <label class="inline-flex items-center gap-2 text-brand-text cursor-pointer">
          <input type="checkbox" data-loc-filter="open_now" class="accent-brand-aqua w-4 h-4" />
          Open now (lobby)
        </label>
        <span class="text-xs text-brand-muted" data-loc-count aria-live="polite">{sorted.length} of {sorted.length}</span>
      </fieldset>
      <p class="hidden mt-2 text-sm text-brand-terra font-medium" data-loc-error aria-live="polite"></p>

      <!-- County jump chips -->
      {regions.length > 1 && (
        <nav class="mt-5 flex flex-wrap gap-2" aria-label="Jump to county" data-county-nav>
          {regions.map((region) => {
            const slug = region.toLowerCase().replace(/\s+/g, "-");
            const count = sorted.filter((l) => l.data.region === region).length;
            return (
              <a
                href={`#county-${slug}`}
                class="inline-flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 px-4 py-1.5 text-sm font-semibold text-white hover:bg-brand-gold hover:border-brand-gold hover:text-brand-navy transition-colors"
              >
                {region.replace(" County", "")}
                <span class="text-[11px] font-bold opacity-70">{count}</span>
              </a>
            );
          })}
        </nav>
      )}
    </div>
  </section>

  <!-- Map + results -->
  <section class="py-10 lg:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-8">
        <!-- Map -->
        <div class="order-2 lg:order-1">
          <div id="loc-map" class="w-full h-[420px] lg:h-[640px] rounded-xl border border-brand-navy/10 overflow-hidden" aria-label="Map of Texas Gulf Bank locations"></div>
          <p class="mt-3 text-xs text-brand-muted">
            Map tiles © <a href="https://www.openstreetmap.org/copyright" class="underline underline-offset-2 hover:text-brand-navy-light" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors. Hours may change on holidays or during severe weather.
          </p>
        </div>

        <!-- Results list grouped by county -->
        <div class="order-1 lg:order-2">
          <div data-loc-results>
            {regions.map((region) => (
              <div data-loc-region={region} id={`county-${region.toLowerCase().replace(/\s+/g, "-")}`} class="scroll-mt-28">
                <h2 class="font-display text-xl sm:text-2xl font-black text-brand-navy tracking-tight mt-8 first:mt-0 mb-4 pb-2 border-b border-brand-navy/15">
                  {region}
                </h2>
                <div class="space-y-5" data-loc-region-list>
                  {sorted.filter((l) => l.data.region === region).map((l) => {
                    const lobbyToday = todayRows(l.data.hours.lobby);
                    return (
                      <article
                        class="border border-brand-navy/10 rounded-lg overflow-hidden bg-white hover:border-brand-aqua/60 hover:shadow-md transition-all"
                        data-loc-card={l.id}
                        data-loc-lat={l.data.lat}
                        data-loc-lng={l.data.lng}
                        data-loc-city={l.data.city.toLowerCase()}
                        data-loc-zip={l.data.zip}
                        data-loc-name={l.data.name.toLowerCase()}
                        data-loc-drive={l.data.has_drive_thru ? "1" : "0"}
                      >
                        {l.data.photo && (
                          <div class="h-36 bg-brand-navy overflow-hidden">
                            <img src={l.data.photo} alt={`Texas Gulf Bank ${l.data.name} Banking Center`} loading="lazy" decoding="async" width="1000" height="667" class="w-full h-full object-cover" />
                          </div>
                        )}
                        <div class="p-5 sm:p-6">
                          <div class="flex items-start justify-between gap-4">
                            <div>
                              <h3 class="font-display text-lg font-bold text-brand-navy leading-snug">
                                <a href={`/locations/${l.id}/`} class="hover:text-brand-blue transition-colors">{l.data.name} Banking Center</a>
                              </h3>
                              <p class="mt-1 text-sm font-semibold text-brand-navy-light">
                                <a href={`tel:${l.data.phone.replace(/[^0-9]/g, "")}`} class="hover:text-brand-gold-dark transition-colors">{l.data.phone}</a>
                              </p>
                            </div>
                            <span
                              class="inline-flex items-center gap-1.5 shrink-0 rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide"
                              data-loc-open-badge={l.id}
                            >
                              <span class="w-1.5 h-1.5 rounded-full" data-loc-open-dot></span>
                              <span data-loc-open-text>Open now</span>
                            </span>
                          </div>

                          <p class="mt-2 text-sm text-brand-muted leading-relaxed">
                            {l.data.street}{l.data.suite ? ", " + l.data.suite : ""}, {l.data.city}, {l.data.state} {l.data.zip}
                          </p>

                          <dl class="mt-3 text-sm space-y-0.5">
                            <div class="flex gap-2">
                              <dt class="text-brand-muted shrink-0">Lobby:</dt>
                              <dd class="text-brand-text" data-loc-hours={l.id}>{hoursSummary(l.data.hours.lobby)}</dd>
                            </div>
                            {l.data.hours.drive_thru.length > 0 && (
                              <div class="flex gap-2">
                                <dt class="text-brand-muted shrink-0">Drive-thru:</dt>
                                <dd class="text-brand-text">{hoursSummary(l.data.hours.drive_thru)}</dd>
                              </div>
                            )}
                          </dl>
                          {/* Today's hours, revealed client-side */}
                          <p class="hidden mt-2 text-sm font-semibold" data-loc-today={l.id}></p>

                          <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
                            <a
                              href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${l.data.street}${l.data.suite ? " " + l.data.suite : ""}, ${l.data.city}, ${l.data.state} ${l.data.zip}`)}`}
                              class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-navy-light hover:text-brand-gold-dark transition-colors"
                            >
                              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                              Get Directions
                            </a>
                            <a
                              href={`/locations/${l.id}/`}
                              class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-navy hover:text-brand-blue transition-colors"
                            >
                              Branch Details
                              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                            </a>
                          </div>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
          <p class="hidden mt-6 text-center text-brand-muted" data-loc-empty>
            No locations match your search. Try a different city or ZIP, or call 800.467.7216.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // ── Locations index: open-now badges, search, filters, geolocate sort + distances, map sync ──
  const LOCATIONS = JSON.parse(document.getElementById("__LOCATIONS_JSON__")?.textContent || "[]");

  function loadLeaflet() {
    return new Promise((resolve, reject) => {
      if (window.L) return resolve(window.L);
      const css = document.createElement("link");
      css.rel = "stylesheet";
      css.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
      document.head.appendChild(css);
      const script = document.createElement("script");
      script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      script.onload = () => resolve(window.L);
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  const tz = "America/Chicago";
  function nowInCentral() {
    const parts = new Intl.DateTimeFormat("en-US", {
      timeZone: tz,
      weekday: "short",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    }).formatToParts(new Date());
    const get = (t) => parts.find((p) => p.type === t)?.value || "";
    const dayMap: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
    let hour = parseInt(get("hour"), 10);
    const minute = parseInt(get("minute"), 10);
    if (hour === 24) hour = 0;
    return { dayNum: dayMap[get("weekday")], minutes: hour * 60 + minute };
  }

  function dayInRange(daysLabel: string, dayNum: number) {
    if (daysLabel.includes("Sat")) return dayNum === 6;
    if (daysLabel.includes("Sun")) return dayNum === 0;
    if (daysLabel.includes("Mon")) return dayNum >= 1 && dayNum <= 5;
    if (daysLabel.includes("Fri")) return dayNum >= 1 && dayNum <= 5;
    return true;
  }

  function isOpenNow(loc: any) {
    const { dayNum, minutes } = nowInCentral();
    for (const r of loc.lobby || []) {
      if (!dayInRange(r.days, dayNum)) continue;
      const open = parseInt((r.open24 || "00:00").split(":")[0], 10) * 60 + parseInt((r.open24 || "00:00").split(":")[1], 10);
      const close = parseInt((r.close24 || "23:59").split(":")[0], 10) * 60 + parseInt((r.close24 || "23:59").split(":")[1], 10);
      if (minutes >= open && minutes < close) return true;
    }
    return false;
  }

  function distanceKm(a: any, b: any) {
    const R = 6371;
    const dLat = ((b.lat - a.lat) * Math.PI) / 180;
    const dLng = ((b.lng - a.lng) * Math.PI) / 180;
    const s =
      Math.sin(dLat / 2) ** 2 +
      Math.cos((a.lat * Math.PI) / 180) * Math.cos((b.lat * Math.PI) / 180) * Math.sin(dLng / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(s));
  }

  // ── Open-now badges on every card (server HTML is neutral until JS paints them) ──
  for (const loc of LOCATIONS) {
    const badge = document.querySelector(`[data-loc-open-badge="${loc.id}"]`);
    if (!badge) continue;
    const open = isOpenNow(loc);
    // Brand Green = open, Terra = closed (palette-consistent status colors)
    badge.classList.add(open ? "bg-green-50" : "bg-[#C25C29]/10");
    badge.classList.add(open ? "text-brand-rate" : "text-brand-terra");
    const dot = badge.querySelector("[data-loc-open-dot]");
    if (dot) dot.classList.add(open ? "bg-brand-rate" : "bg-brand-terra");
    const txt = badge.querySelector("[data-loc-open-text]");
    if (txt) txt.textContent = open ? "Open now" : "Closed";

    // Today's hours line under the weekly summary
    const todayEl = document.querySelector(`[data-loc-today="${loc.id}"]`);
    if (todayEl) {
      const { dayNum } = nowInCentral();
      const names = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
      const today = names[dayNum];
      for (const r of loc.lobby || []) {
        if (dayInRange(r.days, dayNum)) {
          todayEl.textContent = `Lobby today (${today}): ${r.open} – ${r.close}`;
          todayEl.classList.remove("hidden");
          break;
        }
      }
    }
  }

  const cards = [...document.querySelectorAll("[data-loc-card]")];
  const searchInput = document.querySelector("[data-loc-search]") as HTMLInputElement | null;
  const form = document.querySelector("[data-loc-search-form]");
  const geolocateBtn = document.querySelector("[data-loc-geolocate]");
  const emptyMsg = document.querySelector("[data-loc-empty]");
  const countEl = document.querySelector("[data-loc-count]");
  const errorEl = document.querySelector("[data-loc-error]");
  const filterChecks = [...document.querySelectorAll("[data-loc-filter]")];
  let userPos: { lat: number; lng: number } | null = null;

  function applyFilters() {
    const query = (searchInput?.value || "").trim().toLowerCase();
    const wantDrive = document.querySelector('[data-loc-filter="drive_thru"]')?.checked !== false;
    const wantOpen = document.querySelector('[data-loc-filter="open_now"]')?.checked === true;

    let visible: { id: string; dist: number; card: HTMLElement }[] = [];
    for (const card of cards as HTMLElement[]) {
      const id = card.dataset.locCard!;
      const loc = LOCATIONS.find((l: any) => l.id === id);
      if (!loc) continue;
      const hay = `${card.dataset.locName} ${card.dataset.locCity} ${card.dataset.locZip} ${loc.street} ${loc.region}`.toLowerCase();
      if (query && !hay.includes(query)) continue;
      if (!wantDrive && !loc.has_drive_thru) continue;
      if (wantOpen && !isOpenNow(loc)) continue;
      visible.push({ id, dist: userPos ? distanceKm(userPos, loc) : Infinity, card });
    }

    if (userPos) visible.sort((a, b) => a.dist - b.dist);

    // Distance labels when user location known
    for (const v of visible) {
      const existing = v.card.querySelector("[data-loc-distance]");
      if (userPos) {
        const mi = (v.dist * 0.621371).toFixed(1);
        if (existing) existing.textContent = `${mi} mi away`;
        else {
          const span = document.createElement("span");
          span.className = "ml-auto text-xs font-semibold text-brand-muted";
          span.dataset.locDistance = "";
          span.textContent = `${mi} mi away`;
          v.card.querySelector(".p-5, .p-6")?.prepend(span);
        }
      }
    }

    const visibleIds = new Set(visible.map((v) => v.id));

    // Re-append visible cards in sorted order within their region groups
    if (userPos) {
      for (const group of document.querySelectorAll("[data-loc-region-list]")) {
        const kids = [...group.children].filter((c) => visibleIds.has((c as HTMLElement).dataset.locCard!));
        kids.sort((a, b) =>
          visible.findIndex((v) => v.id === (a as HTMLElement).dataset.locCard) -
          visible.findIndex((v) => v.id === (b as HTMLElement).dataset.locCard)
        );
        for (const kid of kids) group.appendChild(kid);
      }
    }

    // Hide empty region headers
    for (const regionWrap of document.querySelectorAll("[data-loc-region]")) {
      const list = regionWrap.querySelector("[data-loc-region-list]")!;
      const anyVisible = [...list.children].some((c) => visibleIds.has((c as HTMLElement).dataset.locCard!));
      (regionWrap as HTMLElement).style.display = anyVisible ? "" : "none";
    }

    for (const card of cards as HTMLElement[]) {
      card.style.display = visibleIds.has(card.dataset.locCard!) ? "" : "none";
    }
    emptyMsg?.classList.toggle("hidden", visible.length > 0);
    if (countEl) {
      countEl.textContent = userPos
        ? `${visible.length} of ${cards.length} · sorted by distance`
        : `${visible.length} of ${cards.length}`;
    }
    if (window.__locMap) {
      window.__locMap.eachLayer((layer: any) => {
        if (layer.options?.locId) {
          const show = visibleIds.has(layer.options.locId);
          if (layer.options.__wasShown === undefined) layer.options.__wasShown = true;
          if (show !== layer.options.__wasShown) {
            if (show) layer.addTo(window.__locMap);
            else layer.remove();
            layer.options.__wasShown = show;
          }
        }
      });
    }
  }

  async function initMap() {
    try {
      const L = await loadLeaflet();
      const map = L.map("loc-map").setView([29.55, -95.45], 9);
      window.__locMap = map;
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 18,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      // Brand-colored pin (navy circle, gold ring) via divIcon — no image assets
      const brandIcon = L.divIcon({
        className: "",
        html: `<div style="width:28px;height:28px;border-radius:9999px;background:#19294B;border:3px solid #FFE66D;box-shadow:0 3px 10px rgba(25,41,75,.45);display:flex;align-items:center;justify-content:center;">
                 <div style="width:8px;height:8px;border-radius:9999px;background:#39B6D3;"></div>
               </div>`,
        iconSize: [28, 28],
        iconAnchor: [14, 14],
        popupAnchor: [0, -14],
      });

      const bounds: [number, number][] = [];
      for (const loc of LOCATIONS) {
        const marker = L.marker([loc.lat, loc.lng], { locId: loc.id, __wasShown: true, icon: brandIcon }).addTo(map);
        marker.bindPopup(
          `<strong>${loc.name} Banking Center</strong><br/>${loc.street}${loc.suite ? ", " + loc.suite : ""}<br/>${loc.city}, ${loc.state} ${loc.zip}<br/><a href="/locations/${loc.id}/">View details</a>`
        );
        bounds.push([loc.lat, loc.lng]);
      }
      if (bounds.length) map.fitBounds(bounds, { padding: [40, 40] });
    } catch (e) {
      console.warn("Map unavailable", e);
    }
  }

  searchInput?.addEventListener("input", applyFilters);
  filterChecks.forEach((c) => c.addEventListener("change", applyFilters));
  form?.addEventListener("submit", (e) => e.preventDefault());

  geolocateBtn?.addEventListener("click", () => {
    if (!navigator.geolocation) {
      if (errorEl) errorEl.textContent = "Location isn't available in this browser — try searching by city or ZIP instead.";
      return;
    }
    geolocateBtn.setAttribute("disabled", "");
    geolocateBtn.textContent = "Locating…";
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        userPos = { lat: pos.coords.latitude, lng: pos.coords.longitude };
        geolocateBtn.removeAttribute("disabled");
        geolocateBtn.textContent = "Use my location";
        errorEl?.classList.add("hidden");
        if (window.__locMap) {
          window.__locMap.setView([userPos.lat, userPos.lng], 10);
        }
        applyFilters();
      },
      () => {
        geolocateBtn.removeAttribute("disabled");
        geolocateBtn.textContent = "Use my location";
        if (errorEl) {
          errorEl.textContent = "We couldn't get your location — it may be blocked in your browser settings. Try searching by city or ZIP instead.";
          errorEl.classList.remove("hidden");
        }
      },
      { timeout: 8000 }
    );
  });

  applyFilters();
  initMap();
</script>

