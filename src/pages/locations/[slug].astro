---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const locations = await getCollection("locations");
  return locations.map((loc) => ({
    params: { slug: loc.id },
    props: { loc },
  }));
}

const { loc } = Astro.props;
const d = loc.data;
const allLocations = await getCollection("locations");

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${d.street}${d.suite ? " " + d.suite : ""}, ${d.city}, ${d.state} ${d.zip}`
)}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${d.street}${d.suite ? " " + d.suite : ""}, ${d.city}, ${d.state} ${d.zip}`
)}`;
const telHref = `tel:${d.phone.replace(/[^0-9]/g, "")}`;

// Nearby: genuinely nearest by coordinates (haversine), not alphabetical
function kmBetween(a: { lat: number; lng: number }, b: { lat: number; lng: number }) {
  const R = 6371;
  const dLat = ((b.lat - a.lat) * Math.PI) / 180;
  const dLng = ((b.lng - a.lng) * Math.PI) / 180;
  const s =
    Math.sin(dLat / 2) ** 2 +
    Math.cos((a.lat * Math.PI) / 180) * Math.cos((b.lat * Math.PI) / 180) * Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(s));
}
const nearby = allLocations
  .filter((l) => l.id !== loc.id)
  .sort((a, b) => kmBetween(d, a.data) - kmBetween(d, b.data))
  .slice(0, 3);

const fullAddress = `${d.street}${d.suite ? ", " + d.suite : ""}, ${d.city}, ${d.state} ${d.zip}`;
const pageTitle = `${d.name} ATM and Banking Center`;
const pageDescription = `Texas Gulf Bank ${d.name} branch in ${d.city}, TX. Lobby and drive-thru hours, phone ${d.phone}, directions, and services.`;

// Expand "Mon - Fri" style ranges into per-day rows for display (Southwest/Vibe pattern)
const DAY_ORDER = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
const DAY_ABBR: Record<string, string> = {
  Mon: "Monday", Tue: "Tuesday", Wed: "Wednesday", Thu: "Thursday",
  Fri: "Friday", Sat: "Saturday", Sun: "Sunday",
};

function expandDays(rows: { days: string; open: string; close: string }[]) {
  const out: { day: string; open: string; close: string }[] = [];
  for (const row of rows) {
    const parts = row.days.split("-").map((s) => s.trim());
    if (parts.length === 2 && DAY_ABBR[parts[0]] && DAY_ABBR[parts[1]]) {
      const start = DAY_ORDER.indexOf(DAY_ABBR[parts[0]]);
      const end = DAY_ORDER.indexOf(DAY_ABBR[parts[1]]);
      for (let i = start; i <= end; i++) {
        out.push({ day: DAY_ORDER[i], open: row.open, close: row.close });
      }
    } else if (DAY_ABBR[parts[0]]) {
      out.push({ day: DAY_ABBR[parts[0]], open: row.open, close: row.close });
    } else {
      out.push({ day: row.days, open: row.open, close: row.close });
    }
  }
  return out;
}

const lobbyDays = expandDays(d.hours.lobby);
const driveThruDays = expandDays(d.hours.drive_thru);
const hasPhoto = Boolean(d.photo);

// JSON-LD structured data for local search (BankOrCreditUnion)
function toIsoDay(daysLabel: string): string[] {
  const map: Record<string, string> = { Mon: "Monday", Tue: "Tuesday", Wed: "Wednesday", Thu: "Thursday", Fri: "Friday", Sat: "Saturday", Sun: "Sunday" };
  const parts = daysLabel.split("-").map((s) => s.trim());
  if (parts.length === 2 && map[parts[0]] && map[parts[1]]) {
    const order = Object.values(map);
    return order.slice(order.indexOf(map[parts[0]]), order.indexOf(map[parts[1]]) + 1);
  }
  return map[parts[0]] ? [map[parts[0]]] : [];
}
const openingHours = [
  ...d.hours.lobby.map((r) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: toIsoDay(r.days),
    opens: r.open24 || r.open,
    closes: r.close24 || r.close,
  })),
  ...d.hours.drive_thru.map((r) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: toIsoDay(r.days),
    opens: r.open24 || r.open,
    closes: r.close24 || r.close,
    description: "Drive-thru",
  })),
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BankOrCreditUnion",
  name: `Texas Gulf Bank ${pageTitle}`,
  telephone: d.phone,
  url: `/locations/${loc.id}/`,
  address: {
    "@type": "PostalAddress",
    streetAddress: `${d.street}${d.suite ? ", " + d.suite : ""}`,
    addressLocality: d.city,
    addressRegion: d.state,
    postalCode: d.zip,
    addressCountry: "US",
  },
  geo: { "@type": "GeoCoordinates", latitude: d.lat, longitude: d.lng },
  openingHoursSpecification: openingHours,
  parentOrganization: { "@type": "BankOrCreditUnion", name: "Texas Gulf Bank N.A.", url: "/" },
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="bg-brand-cream border-b border-brand-navy/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 text-sm">
      <ol class="flex items-center gap-2 text-brand-muted">
        <li><a href="/" class="hover:text-brand-navy-light transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/locations/" class="hover:text-brand-navy-light transition-colors">Locations</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-brand-text font-medium" aria-current="page">{d.name}</li>
      </ol>
    </div>
  </nav>

  <!-- Header: name, address, phone, primary actions -->
  <section class="bg-brand-cream border-b border-brand-navy/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-blue mb-2">{d.region}</p>
      <h1 class="font-display text-4xl sm:text-5xl font-black text-brand-navy leading-[1.05] tracking-tight text-balance">
        {d.name} ATM and Banking Center
      </h1>
      <p class="mt-4 text-lg text-brand-text">
        {d.street}{d.suite ? ", " + d.suite : ""}<br class="sm:hidden" />
        <span class="sm:inline"> · </span>{d.city}, {d.state} {d.zip}
      </p>
      <p class="mt-1 text-lg">
        <a href={telHref} class="text-brand-navy-light font-bold hover:text-brand-gold-dark transition-colors">{d.phone}</a>
      </p>
      <p class="mt-3">
        <span
          id="branch-open-badge"
          class="hidden inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide"
          data-branch-hours={JSON.stringify(d.hours.lobby.map((r) => ({ days: r.days, open24: r.open24 || "", close24: r.close24 || "" })))}
        >
          <span class="w-1.5 h-1.5 rounded-full" data-open-dot></span>
          <span data-open-text></span>
        </span>
      </p>

      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a
          href={directionsUrl}
          class="inline-flex items-center justify-center gap-2 bg-brand-navy text-white px-6 py-3 rounded-lg text-sm font-bold hover:bg-brand-navy-light transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Get Directions
        </a>
        <a
          href={telHref}
          class="inline-flex items-center justify-center gap-2 bg-brand-gold text-brand-navy px-6 py-3 rounded-lg text-sm font-bold hover:bg-brand-gold-light transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call Us Now
        </a>
      </div>
    </div>
  </section>

  <!-- Body: photo + hours + services | map + connect -->
  <section class="py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
        <!-- Left column -->
        <div class="lg:col-span-7">
          {hasPhoto && (
            <div class="rounded-xl overflow-hidden border border-brand-navy/10 mb-8">
              <img src={d.photo} alt={`Exterior of the Texas Gulf Bank ${d.name} location`} class="w-full aspect-[16/9] object-cover" loading="lazy" />
            </div>
          )}

          <h2 class="font-display text-2xl sm:text-3xl font-black text-brand-navy tracking-tight">Hours of Operation</h2>
          <p class="mt-2 text-sm text-brand-muted">All times US Central. Hours may change on holidays or during severe weather.</p>

          <div class="mt-6 grid sm:grid-cols-2 gap-6">
            {lobbyDays.length > 0 && (
              <div>
                <h3 class="font-display font-semibold text-brand-navy text-base mb-2">Lobby</h3>
                <dl class="text-sm">
                  {lobbyDays.map((row) => (
                    <div class="flex items-baseline justify-between gap-4 py-1.5 border-b border-brand-navy/5 last:border-b-0">
                      <dt class="text-brand-text">{row.day}</dt>
                      <dd class="text-brand-muted text-right">{row.open} – {row.close}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
            {driveThruDays.length > 0 && (
              <div>
                <h3 class="font-display font-semibold text-brand-navy text-base mb-2">Drive-Thru</h3>
                <dl class="text-sm">
                  {driveThruDays.map((row) => (
                    <div class="flex items-baseline justify-between gap-4 py-1.5 border-b border-brand-navy/5 last:border-b-0">
                      <dt class="text-brand-text">{row.day}</dt>
                      <dd class="text-brand-muted text-right">{row.open} – {row.close}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </div>

          <h2 class="font-display text-2xl sm:text-3xl font-black text-brand-navy tracking-tight mt-10">Services</h2>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {(d.services.length ? d.services : ["ATM", "Drive-Thru"]).map((s) => (
              <span class="inline-flex items-center gap-1.5 bg-brand-cream border border-brand-navy/10 rounded-full px-4 py-2 text-sm text-brand-text">
                <svg class="w-4 h-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {s}
              </span>
            ))}
            {d.languages.map((lang) => (
              <span class="inline-flex items-center gap-1.5 bg-brand-gold-pale border border-brand-gold/30 rounded-full px-4 py-2 text-sm text-brand-gold-dark">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg>
                {lang}
              </span>
            ))}
          </div>

          {d.notes && (
            <p class="mt-6 text-sm text-brand-muted leading-relaxed border-l-4 border-brand-aqua pl-4">{d.notes}</p>
          )}

          <!-- Fraud/security note (Stellar pattern, TGB voice) -->
          <div class="mt-8 border border-brand-terra/25 bg-brand-cream rounded-lg p-5">
            <p class="text-sm text-brand-text leading-relaxed">
              <strong>Security note:</strong> Texas Gulf Bank will never call, text, or email you asking for
              your username, password, token code, or one-time passcode. If someone asks for those details,
              hang up and call us at <a href="tel:8004677216" class="text-brand-navy-light font-semibold underline underline-offset-2">800.467.7216</a>.
              <a href="/blog/bank-impersonation-scams" class="text-brand-navy-light font-semibold underline underline-offset-2 ml-1">Learn more about scam protection</a>.
            </p>
          </div>
        </div>

        <!-- Right column: map + connect -->
        <div class="lg:col-span-5">
          <div class="border border-brand-navy/10 rounded-lg overflow-hidden">
            <div class="aspect-[4/3] bg-brand-cream">
              <iframe
                title={`Map of Texas Gulf Bank ${d.name}`}
                src={`https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`}
                class="w-full h-full border-0"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>

          <div class="mt-6 border border-brand-navy/10 rounded-lg p-6">
            <h2 class="font-display text-xl font-bold text-brand-navy">Connect With Us</h2>
            <address class="mt-4 not-italic text-brand-text leading-relaxed">
              {d.street}{d.suite ? ", " + d.suite : ""}<br />
              {d.city}, {d.state} {d.zip}
            </address>
            <div class="mt-5 flex flex-col gap-3">
              <a href={telHref} class="inline-flex items-center gap-3 border border-brand-navy/15 text-brand-text px-5 py-3 rounded-lg text-sm font-semibold hover:bg-brand-cream transition-colors">
                <svg class="w-5 h-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call {d.phone}
              </a>
              <a href={directionsUrl} class="inline-flex items-center gap-3 border border-brand-navy/15 text-brand-text px-5 py-3 rounded-lg text-sm font-semibold hover:bg-brand-cream transition-colors">
                <svg class="w-5 h-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                Get Directions
              </a>
              <a href="https://www.texasgulfbank.com/contact-texas-gulf-bank/" class="inline-flex items-center justify-center gap-2 bg-brand-aqua text-white px-5 py-3 rounded-lg text-sm font-bold hover:bg-brand-blue transition-colors">
                Contact a Banker
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby locations -->
  <section class="pb-16 lg:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl sm:text-3xl font-black text-brand-navy tracking-tight">Nearby Locations</h2>
      <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {nearby.map((l) => (
          <a
            href={`/locations/${l.id}/`}
            class="group border border-brand-navy/10 rounded-lg p-6 hover:border-brand-aqua/50 hover:shadow-md transition-all bg-white"
          >
            <h3 class="font-display text-lg font-bold text-brand-navy group-hover:text-brand-blue transition-colors">{l.data.name} ATM and Banking Center</h3>
            <p class="mt-2 text-sm text-brand-muted leading-relaxed">
              {l.data.street}{l.data.suite ? ", " + l.data.suite : ""}<br />
              {l.data.city}, {l.data.state} {l.data.zip}
            </p>
            <span class="inline-flex items-center gap-1 mt-4 text-sm font-semibold text-brand-navy-light group-hover:text-brand-gold-dark transition-colors">
              View details
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Open-now badge for this branch (America/Chicago)
  const badge = document.getElementById("branch-open-badge");
  if (badge) {
    const rows = JSON.parse(badge.dataset.branchHours || "[]");
    const parts = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/Chicago",
      weekday: "short",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    }).formatToParts(new Date());
    const get = (t) => parts.find((p) => p.type === t)?.value || "";
    const dayMap = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
    let hour = parseInt(get("hour"), 10);
    if (hour === 24) hour = 0;
    const dayNum = dayMap[get("weekday")];
    const minutes = hour * 60 + parseInt(get("minute"), 10);

    const inRange = (daysLabel, dayNum) => {
      if (daysLabel.includes("Sat")) return dayNum === 6;
      if (daysLabel.includes("Sun")) return dayNum === 0;
      if (daysLabel.includes("Mon") || daysLabel.includes("Fri")) return dayNum >= 1 && dayNum <= 5;
      return true;
    };

    const toMin = (t) => {
      if (!t || !t.includes(":")) return null;
      const [h, m] = t.split(":").map(Number);
      return h * 60 + m;
    };

    let openNow = false;
    let todayRow = null;
    for (const r of rows) {
      if (!inRange(r.days, dayNum)) continue;
      todayRow = r;
      const open = toMin(r.open24);
      const close = toMin(r.close24);
      if (open !== null && close !== null && minutes >= open && minutes < close) openNow = true;
    }

    badge.classList.remove("hidden");
    badge.classList.add(openNow ? "bg-green-50" : "bg-red-50", openNow ? "text-green-700" : "text-red-700");
    badge.querySelector("[data-open-dot]")?.classList.add(openNow ? "bg-green-500" : "bg-red-500");
    const txtEl = badge.querySelector("[data-open-text]");
    if (txtEl) {
      const names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
      txtEl.textContent = openNow
        ? "Open now"
        : `Closed · ${todayRow ? `Lobby opens ${todayRow.open24}` : "call for hours"}`;
      if (!openNow && todayRow) {
        // Show the day context when closed
        txtEl.textContent = `Closed now · ${names[dayNum]} hours ${todayRow.open24.replace(":", " ")} – ${todayRow.close24?.replace(":", " ")}`;
      }
    }
  }
</script>
