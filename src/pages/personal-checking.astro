---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import RateTable from "../components/RateTable.astro";

const entry = await getEntry("products", "personal-checking");
const d = entry?.data;
if (!d) throw new Error("Missing products/personal-checking.yaml");

const featured = d.products.filter((p) => p.id !== "vip-high-yield");
const all = d.products;
---

<Layout
  title="Personal Checking Accounts — Free & Interest-Bearing | Texas Gulf Bank"
  description="Compare Texas Gulf Bank personal checking accounts: free interest-bearing Gulf Advantage Checking, Portside everyday checking, Gulf Rewards combined-statement checking, and VIP High Yield. Open online in minutes."
>
  <!-- Hero -->
  <section class="bg-gradient-to-r from-brand-navy via-brand-navy-mid to-brand-aqua text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.05] tracking-tight text-balance max-w-3xl">
        Checking that fits how you actually bank
      </h1>
      <p class="mt-5 text-lg text-white/85 max-w-2xl text-balance leading-relaxed">
        Four personal accounts, one local bank. Whether you want free interest checking,
        simple everyday banking, or tiered rates on higher balances — pick in two minutes,
        open at a branch or online.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href="#compare" class="inline-flex items-center justify-center gap-2 bg-brand-gold text-brand-navy px-7 py-3.5 rounded-lg text-base font-bold hover:bg-white transition-colors">
          Compare all four accounts
        </a>
        <a href="#accounts" class="inline-flex items-center justify-center gap-2 border border-white/35 text-white px-7 py-3.5 rounded-lg text-base font-semibold hover:bg-white/10 transition-colors">
          Explore by need
        </a>
      </div>
    </div>
  </section>

  <!-- Featured product panels -->
  <section id="accounts" class="py-14 lg:py-20 bg-brand-warm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-black text-brand-text tracking-tight text-balance max-w-2xl leading-[1.1]">
        Start with what matters to you.
      </h2>
      <div class="mt-10 grid lg:grid-cols-3 gap-6">
        {featured.map((p, i) => (
          <article class:list={["bg-white border border-brand-navy/10 rounded-lg overflow-hidden flex flex-col", i === 0 && "lg:-mt-0 ring-2 ring-brand-gold"]}>
            <div class="p-6 sm:p-7 flex-1">
              <div class="flex items-center justify-between gap-3">
                <h3 class="font-display text-xl font-bold text-brand-navy">{p.name}</h3>
                {i === 0 && (
                  <span class="shrink-0 inline-flex rounded-full bg-brand-gold-pale border border-brand-gold/40 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-brand-gold-dark">Most popular</span>
                )}
              </div>
              <p class="mt-1.5 text-sm text-brand-muted italic">{p.tagline}</p>

              <div class="mt-5 flex items-baseline gap-2">
                <span class="font-display text-3xl font-black text-brand-blue">{p.monthly_fee}</span>
                <span class="text-sm text-brand-muted">/ month</span>
              </div>
              {p.fee_note && <p class="mt-1 text-xs text-brand-muted leading-relaxed">{p.fee_note}</p>}

              {p.best_for && (
                <p class="mt-4 text-sm text-brand-text"><span class="font-semibold">Best for:</span> {p.best_for}</p>
              )}

              <ul class="mt-5 space-y-2.5">
                {p.highlights.map((h) => (
                  <li class="flex gap-2.5 text-sm text-brand-text leading-relaxed">
                    <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-rate" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    {h}
                  </li>
                ))}
              </ul>

              {p.qualify.length > 0 && p.qualify_label && (
                <div class="mt-5 bg-brand-cream border border-brand-navy/10 rounded-lg p-4">
                  <p class="text-xs font-bold uppercase tracking-wide text-brand-gold-dark">{p.qualify_label}</p>
                  <ul class="mt-2 space-y-1.5 list-disc pl-4 text-xs text-brand-muted leading-relaxed">
                    {p.qualify.map((q) => <li>{q}</li>)}
                  </ul>
                </div>
              )}

              {p.id === "gulf-advantage" && (
                <div class="mt-6">
                  <RateTable section="gulf-advantage" />
                </div>
              )}
            </div>

            <div class="px-6 sm:px-7 pb-6 pt-2 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-brand-navy/5 pt-4">
              <a href={p.open_url} class="inline-flex items-center justify-center gap-2 bg-brand-navy text-white px-5 py-2.5 rounded-lg text-sm font-bold hover:bg-brand-navy-light transition-colors">
                Open this account
              </a>
              <button
                type="button"
                data-disclosure-trigger={p.id}
                class="text-sm font-semibold text-brand-navy-light underline underline-offset-2 hover:text-brand-gold-dark transition-colors"
              >
                Account details
              </button>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-6 text-xs text-brand-muted">
        Looking for tiered rates on larger balances? Our <a href="#compare" class="font-semibold text-brand-navy-light underline underline-offset-2">VIP High Yield Checking</a> is compared below.
      </p>
    </div>
  </section>

  <!-- Comparison table -->
  <section id="compare" class="py-14 lg:py-20 bg-white scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-black text-brand-text tracking-tight text-balance leading-[1.1] max-w-2xl">
        The differences that matter, side by side.
      </h2>
      <p class="mt-3 text-brand-muted max-w-2xl">{d.published}.</p>

      <div class="mt-8 overflow-x-auto rounded-lg border border-brand-navy/10">
        <table class="w-full min-w-[760px] text-sm bg-white">
          <caption class="sr-only">Personal checking account comparison</caption>
          <thead>
            <tr class="bg-brand-navy text-white">
              <th scope="col" class="text-left px-5 py-4 font-display font-bold w-[22%]">Account</th>
              {all.map((p) => (
                <th scope="col" class="text-left px-5 py-4 font-display font-bold">{p.name}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-brand-navy/10 bg-brand-cream/60">
              <th scope="row" class="text-left px-5 py-4 font-semibold text-brand-gold-dark">Monthly fee</th>
              {all.map((p) => (
                <td class="px-5 py-4 align-top">
                  <span class="font-display font-black text-base text-brand-blue">{p.monthly_fee}</span>
                  {p.fee_note && <span class="block mt-0.5 text-xs text-brand-muted leading-snug">{p.fee_note}</span>}
                </td>
              ))}
            </tr>
            {d.compare_rows.map((row) => (
              <tr class="border-b border-brand-navy/10 last:border-b-0 hover:bg-brand-warm/60 transition-colors">
                <th scope="row" class="text-left px-5 py-3.5 font-semibold text-brand-text">{row.label}</th>
                {row.values.map((v) => (
                  <td class:list={["px-5 py-3.5 align-top", v === "—" ? "text-brand-muted" : "text-brand-text"]}>{v}</td>
                ))}
              </tr>
            ))}
            <tr>
              <td class="px-5 py-4"></td>
              {all.map((p) => (
                <td class="px-5 py-4">
                  <a href={p.open_url} class="inline-flex items-center justify-center bg-brand-gold text-brand-navy px-4 py-2 rounded-lg text-xs font-bold hover:bg-brand-gold-light transition-colors whitespace-nowrap">
                    Open
                  </a>
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
      {d.disclaimer_short && <p class="mt-4 text-xs text-brand-muted max-w-3xl">{d.disclaimer_short}</p>}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-brand-navy py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl sm:text-4xl font-black text-white tracking-tight text-balance leading-[1.1]">
        Ready when you are.
      </h2>
      <p class="mt-4 text-lg text-white/80 max-w-xl mx-auto text-balance">
        Open online in minutes, stop by any of our nine banking centers, or call and talk to a local banker.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={d.products[0].open_url} class="inline-flex items-center justify-center gap-2 bg-brand-gold text-brand-navy px-8 py-3.5 rounded-lg text-base font-bold hover:bg-white transition-colors">
          Open an account online
        </a>
        <a href="/locations/" class="inline-flex items-center justify-center gap-2 border border-white/30 text-white px-8 py-3.5 rounded-lg text-base font-semibold hover:bg-white/10 transition-colors">
          Find a banking center
        </a>
      </div>
      <p class="mt-6 text-sm text-white/70">Prefer to talk it through? <a href="tel:8004677216" class="font-bold text-brand-gold underline underline-offset-2">800.467.7216</a></p>
    </div>
  </section>
</Layout>

<!-- Disclosure modal (compliance details, on demand) -->
<div id="disclosure-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-labelledby="disclosure-title">
  <div class="absolute inset-0 bg-brand-navy/70 backdrop-blur-sm" data-disclosure-close></div>
  <div class="relative max-w-2xl mx-auto mt-[6vh] mb-10 bg-white rounded-xl shadow-2xl max-h-[86vh] flex flex-col">
    <div class="flex items-start justify-between gap-4 px-6 pt-6 pb-4 border-b border-brand-navy/10">
      <div>
        <p class="text-xs font-bold uppercase tracking-wide text-brand-gold-dark">Account details</p>
        <h2 id="disclosure-title" class="mt-1 font-display text-xl sm:text-2xl font-black text-brand-navy" data-disclosure-name>Account</h2>
      </div>
      <button type="button" data-disclosure-close aria-label="Close account details" class="shrink-0 w-9 h-9 rounded-full border border-brand-navy/15 text-brand-text hover:bg-brand-cream transition-colors flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="px-6 py-5 overflow-y-auto text-sm text-brand-text leading-relaxed space-y-5" data-disclosure-body></div>
    <div class="px-6 py-4 border-t border-brand-navy/10 flex flex-wrap gap-3 justify-end">
      <a href="tel:8004677216" class="inline-flex items-center gap-2 border border-brand-navy/15 px-4 py-2 rounded-lg text-sm font-semibold text-brand-text hover:bg-brand-cream transition-colors">Call 800.467.7216</a>
      <a href="#" data-disclosure-open-url class="inline-flex items-center gap-2 bg-brand-gold text-brand-navy px-5 py-2 rounded-lg text-sm font-bold hover:bg-brand-gold-light transition-colors">Open this account</a>
    </div>
  </div>
</div>

<script>
  const PRODUCTS = JSON.parse(document.getElementById("__PRODUCTS_JSON__")?.textContent || "[]");
  const modal = document.getElementById("disclosure-modal");
  const nameEl = modal?.querySelector("[data-disclosure-name]");
  const bodyEl = modal?.querySelector("[data-disclosure-body]");
  const openUrlEl = modal?.querySelector("[data-disclosure-open-url]");
  let lastFocus = null;

  function esc(s) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function openDisclosure(id) {
    const p = PRODUCTS.find((x) => x.id === id);
    if (!p || !modal) return;
    lastFocus = document.activeElement;
    if (nameEl) nameEl.textContent = p.name;
    if (openUrlEl) openUrlEl.setAttribute("href", p.open_url || "#");
    if (bodyEl) {
      const rows = [
        ["Monthly maintenance fee", p.monthly_fee + (p.fee_note ? ` — ${p.fee_note}` : "")],
        ["Minimum opening deposit", p.min_opening || "—"],
        ["Earns interest", p.interest ? "Yes" : "No"],
      ];
      let html = `<table class="w-full text-sm border-collapse"><tbody>`;
      for (const [k, v] of rows) {
        html += `<tr class="border-b border-brand-navy/10"><th scope="row" class="text-left py-2.5 pr-4 font-semibold align-top whitespace-nowrap">${k}</th><td class="py-2.5">${esc(v)}</td></tr>`;
      }
      html += `</tbody></table>`;
      if (p.qualify && p.qualify.length > 0 && p.qualify_label) {
        html += `<div><p class="font-semibold text-brand-gold-dark text-xs uppercase tracking-wide">${esc(p.qualify_label)}</p><ul class="mt-2 list-disc pl-4 space-y-1">`;
        for (const q of p.qualify) html += `<li>${esc(q)}</li>`;
        html += `</ul></div>`;
      }
      if (p.details && p.details.length > 0) {
        html += `<div><p class="font-semibold text-brand-gold-dark text-xs uppercase tracking-wide">Additional information</p><ul class="mt-2 list-disc pl-4 space-y-1.5">`;
        for (const dt of p.details) html += `<li>${esc(dt)}</li>`;
        html += `</ul></div>`;
      }
      html += `<div class="bg-brand-cream border border-brand-navy/10 rounded-lg p-4 text-xs text-brand-muted leading-relaxed">
        <p class="font-semibold text-brand-text">Good to know</p>
        <p class="mt-1.5">Accounts closed within 30 days of opening are assessed a $15.00 fee. NSF Return Item Fees and/or Overdraft Paid Item Fees may apply. ATM/Debit card monthly fee, where applicable, is $1.00 per month per account. A complete schedule of fees that may apply to your account is available in the <a class="underline underline-offset-2 font-semibold text-brand-navy-light" href="https://www.texasgulfbank.com/personal-comparison-chart/" target="_blank" rel="noopener">Personal Checking Comparison Chart</a>.</p>
        <p class="mt-2">Contact Texas Gulf Bank at 1-800-467-7216 to obtain a Truth-In-Savings / Reg DD disclosure of terms, conditions, fees, and rate information for any account.</p>
      </div>`;
      if (p.details_url) {
        html += `<p><a href="${esc(p.details_url)}" target="_blank" rel="noopener" class="font-semibold text-brand-navy-light underline underline-offset-2">View full account details on texasgulfbank.com →</a></p>`;
      }
      bodyEl.innerHTML = html;
    }
    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    modal.querySelector("[data-disclosure-close]:not(.absolute)")?.focus();
  }

  function closeDisclosure() {
    if (!modal) return;
    modal.classList.add("hidden");
    document.body.style.overflow = "";
    if (lastFocus) lastFocus.focus();
  }

  document.querySelectorAll("[data-disclosure-trigger]").forEach((btn) => {
    btn.addEventListener("click", () => openDisclosure(btn.getAttribute("data-disclosure-trigger")));
  });
  modal?.querySelectorAll("[data-disclosure-close]").forEach((el) => el.addEventListener("click", closeDisclosure));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) closeDisclosure();
  });
</script>

<script is:inline type="application/json" id="__PRODUCTS_JSON__" set:html={JSON.stringify(d.products)}></script>
