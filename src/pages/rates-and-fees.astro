---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import RateTable from "../components/RateTable.astro";
import FeeSchedule from "../components/FeeSchedule.astro";
import CtaSection from "../components/CtaSection.astro";
import { getEntry } from "astro:content";
import { loadPage, loadRateSheet } from "../lib/cms";

const page = await loadPage("rates");
const home = (await loadPage("home")) ?? {};
const sheet = await loadRateSheet();

const feesEntry = await getEntry("fees", "personal-fees");
const fees = feesEntry?.data;
---

<Layout
  title="Rates & Fees"
  description="Placeholder rates and fees for this concept site. Not current offers."
>
  <!-- Page header -->
  <section class="bg-brand-cream border-b border-brand-navy/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 lg:py-16">
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black text-brand-navy leading-[1.05] tracking-tight text-balance">
        {page?.headline || "Rates & Fees"}
      </h1>
      <p class="placeholder-callout mt-5 max-w-3xl" role="note">Placeholder rates, not current offers.</p>
      <p class="mt-5 text-lg text-brand-muted max-w-2xl text-balance">
        {page?.summary || "The layout below is a rate sheet and fee schedule. Every figure is a placeholder, not a current offer."}
      </p>
    </div>
  </section>

  <!-- Deposit Rates -->
  <section class="py-10 sm:py-14 lg:py-16" id="rates">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="font-display text-3xl sm:text-4xl font-black text-brand-navy tracking-tight text-balance">
          Deposit Rates
        </h2>
        <p class="mt-3 text-base text-brand-muted leading-relaxed">
          Placeholder deposit figures only. Not current offers, and not a complete rate sheet.
        </p>
      </div>

      <div class="mt-8 max-w-3xl">
        {sheet ? <RateTable data={sheet} /> : <RateTable />}
      </div>
    </div>
  </section>

  <!-- Fee Schedule -->
  <section class="py-10 sm:py-14 lg:py-16 bg-brand-warm border-t border-brand-navy/10" id="fees">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="font-display text-3xl sm:text-4xl font-black text-brand-navy tracking-tight text-balance">
          Personal Fee Schedule
        </h2>
        <p class="mt-3 text-base text-brand-muted leading-relaxed">
          Placeholder fee figures only. Not current charges. {fees?.published}
        </p>
      </div>

      <div class="mt-10">
        <FeeSchedule />
      </div>

      <div class="mt-8 sm:mt-12 border border-brand-navy/10 rounded-lg bg-brand-cream/60 p-6 sm:p-8 max-w-4xl">
        <h3 class="font-display text-xl font-semibold text-brand-navy">Disclosures</h3>
        <p class="mt-3 text-sm text-brand-muted leading-relaxed">
          {fees?.disclaimer}
        </p>
        <div class="mt-5 flex flex-wrap gap-4">
          {fees?.full_schedule_url && (
            <a
              href={fees.full_schedule_url}
              class="inline-flex items-center gap-2 font-semibold text-brand-navy-light hover:text-brand-gold-dark transition-colors text-sm"
            >
              View the full published schedule
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <CtaSection home={home} />
</Layout>
