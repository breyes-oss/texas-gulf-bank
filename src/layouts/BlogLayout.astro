---
import '../styles/global.css';
import Header from '../components/Header.astro';

export interface Props {
  title: string;
  date: string;
  image?: string;
  category?: string;
}
const { title, date, image, category } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} | Texas Gulf Bank</title>
    <meta name="description" content={title} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-brand-warm">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="bg-brand-navy text-white text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4 h-10">
        <span class="inline-flex items-center bg-white rounded-sm px-1.5 py-0.5 shrink-0" title="FDIC-Insured - Backed by the full faith and credit of the U.S. Government">
          <img src="/fdic-digital-sign.png" alt="FDIC-Insured - Backed by the full faith and credit of the U.S. Government" class="h-5 w-auto" loading="eager" />
        </span>
        <div class="flex items-center gap-5">
          <a href="/" class="hover:text-brand-gold transition-colors">Home</a>
          <a href="/blog/" class="hover:text-brand-gold transition-colors">Blog</a>
          <span class="hidden sm:inline">Routing Number: 113115484</span>
        </div>
      </div>
    </div>

    <!-- Header (shrinks on scroll) -->
    <Header
      links={[
        { label: "Home", href: "/" },
        { label: "Blog", href: "/blog/", active: true },
      ]}
      showCta={false}
      showHamburger={false}
    />

    <main id="main-content" class="flex-1">
      <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
        {image && (
          <div class="mb-6 rounded-xl overflow-hidden bg-brand-cream">
            <img src={image} alt={title} class="w-full h-48 sm:h-64 object-cover" />
          </div>
        )}
        <div class="flex items-center gap-3 text-sm text-brand-muted mb-4">
          {category && <span class="bg-brand-gold-pale text-brand-gold-dark font-semibold px-2.5 py-1 rounded-full text-xs">{category}</span>}
          <time datetime={date}>{date}</time>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl font-black text-brand-text leading-tight mb-8">{title}</h1>

        <!--
          Page content supplies its own .article-prose wrappers around markdown,
          and places promo embeds outside those wrappers so CTA/rate colors win.
        -->
        <slot />
      </article>
    </main>

    <footer class="bg-brand-navy text-white mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-sm text-gray-400">© 2026 Texas Gulf Bank N.A.</p>
          <div class="flex items-center gap-6 text-sm">
            <a href="/" class="text-gray-300 hover:text-white transition-colors">Home</a>
            <a href="/blog/" class="text-gray-300 hover:text-white transition-colors">All Posts</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
